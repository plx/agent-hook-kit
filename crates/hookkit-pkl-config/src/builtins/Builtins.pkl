/// Aggregator for the embedded `post-tool-use-agent-hook` builtin tool specs.
///
/// Each builtin lives in its own file under `tools/`. This module imports each
/// and re-exports it as a top-level property so existing user configs that do
/// `import "Builtins.pkl"` and reference `Builtins.ruff` (etc.) keep working.
///
/// Adding a new builtin: drop a `tools/<name>.pkl` exporting `spec`, then add
/// one alphabetically-ordered import + one re-export below.

module agent_hook_kit.PostToolUseBuiltins

import "Config.pkl" as Config
import "tools/biome.pkl" as biomeMod
import "tools/cargo_clippy.pkl" as cargoClippyMod
import "tools/cargo_fmt.pkl" as cargoFmtMod
import "tools/eslint.pkl" as eslintMod
import "tools/prettier.pkl" as prettierMod
import "tools/ruff.pkl" as ruffMod

biome: Config.ToolSpec = biomeMod.spec
cargoClippy: Config.ToolSpec = cargoClippyMod.spec
cargoFmt: Config.ToolSpec = cargoFmtMod.spec
eslint: Config.ToolSpec = eslintMod.spec
prettier: Config.ToolSpec = prettierMod.spec
ruff: Config.ToolSpec = ruffMod.spec
