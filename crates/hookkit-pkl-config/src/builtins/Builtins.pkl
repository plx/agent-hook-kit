/// Embedded tool specs for the `post-tool-use-agent-hook` runner.
///
/// Each builtin produces a `ToolSpec` equivalent to the hand-written Rust spec
/// it replaced in `hook-inventory/agent-hooks/src/specs.rs`. The bit-for-bit
/// equality tests in `tests/builtins.rs` guard against drift.

module agent_hook_kit.PostToolUseBuiltins

import "Config.pkl" as Config

ruff: Config.ToolSpec = new Config.ToolSpec {
  id = "ruff"
  displayName = "Ruff"
  executable = "ruff"
  installHint = "install ruff with `brew install ruff` or add it to the project"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.py"; "**/*.py"; "*.pyi"; "**/*.pyi" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "format"
        "--quiet"
        "--force-exclude"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        failure = new Listing<Int> { 2 }
      }
      writes = "target-files"
    }
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "check"
        "--force-exclude"
        "--fix"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "check"
        "--force-exclude"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "fix"; "verify" }
}

prettier: Config.ToolSpec = new Config.ToolSpec {
  id = "prettier"
  displayName = "Prettier"
  executable = "prettier"
  installHint = "install prettier with `brew install prettier` or add it to the project"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.js"; "**/*.js"
      "*.jsx"; "**/*.jsx"
      "*.mjs"; "**/*.mjs"
      "*.cjs"; "**/*.cjs"
      "*.ts"; "**/*.ts"
      "*.tsx"; "**/*.tsx"
      "*.mts"; "**/*.mts"
      "*.cts"; "**/*.cts"
      "*.css"; "**/*.css"
      "*.scss"; "**/*.scss"
      "*.less"; "**/*.less"
      "*.html"; "**/*.html"
      "*.json"; "**/*.json"
      "*.json5"; "**/*.json5"
      "*.jsonc"; "**/*.jsonc"
      "*.yaml"; "**/*.yaml"
      "*.yml"; "**/*.yml"
      "*.markdown"; "**/*.markdown"
      "*.markdown.mdx"; "**/*.markdown.mdx"
      "*.md"; "**/*.md"
      "*.graphql"; "**/*.graphql"
      "*.handlebars"; "**/*.handlebars"
      "*.svelte"; "**/*.svelte"
      "*.astro"; "**/*.astro"
      "*.htmlangular"; "**/*.htmlangular"
      "*.vue"; "**/*.vue"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "--write"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }
}

