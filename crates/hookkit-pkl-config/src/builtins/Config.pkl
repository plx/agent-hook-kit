/// Schema for the agent-hook-kit `post-tool-use-agent-hook` runner.
///
/// Project configs typically `amends` this module. The runner's Pkl driver
/// also embeds it so config files loaded via discovery can resolve `Config`,
/// `Builtins`, and the argv-token classes.

module agent_hook_kit.PostToolUseConfig

/// Top-level runner settings.
class Settings {
  /// Number of independent tool jobs to run concurrently. 0 means auto.
  /// v0 honors `1` and `>=1`; auto is reserved for future use.
  jobs: UInt?

  /// Stop after an operational failure (missing tool, configured failure code).
  /// The immediate runner stops running later tools; the Stop-time runner
  /// skips the failing tool's remaining remedies but still repairs files for
  /// unrelated tools. Default: true.
  failFast: Boolean?

  /// Continue running later tools after an earlier tool reports issues.
  continueAfterIssues: Boolean?

  /// Global file exclusions applied before per-tool selection, matched
  /// against project-relative paths. Replaces the default
  /// `**/.git/**` and `**/node_modules/**` when set.
  exclude: Listing<String>?

  /// How to handle optional common-output intents the harness cannot represent.
  loweringPolicy: ("strict" | "best-effort" | "best-effort-with-warnings")?

  /// Directory for the immediate runner's full diagnostic artifacts. Relative
  /// paths resolve from the project root. Default:
  /// `.agent-hook-kit/post-tool-use`. The Stop-time runner writes its artifacts
  /// to session state instead and never treats this directory as a candidate.
  diagnosticsDirectory: String?

  /// What to do when a configured tool executable is missing. At Stop,
  /// `user-notice` reports the tool to the user without blocking or
  /// re-queueing its files; the other policies block completion.
  missingToolPolicy: ("user-notice" | "hard-failure" | "harness-block")?

  /// Deadline in seconds for each external tool command; 0 disables it.
  /// A command that runs longer is killed together with its process group
  /// and reported as an operational failure. Default: 300, below the
  /// 600-second default hook timeout of Claude Code and Codex. Set it below
  /// the hook timeout you configure (Antigravity defaults to 30 seconds).
  commandTimeoutSeconds: UInt?

  /// Optional stop-time file-activity fallback overrides. Omit to use the
  /// runtime defaults represented by FileActivity.
  fileActivity: FileActivity?

  /// Optional field-preserving overrides for deferred Stop reporting. Rust
  /// supplies the built-in defaults; null nested fields inherit prior layers.
  deferredReporting: DeferredReporting?
}

class TemplatePair {
  user: String?
  agent: String?
}

class FileGroup {
  id: String
  displayName: String
  include: Listing<String>
}

/// A patch over the built-in deferred reporting contract. Empty strings
/// intentionally suppress that audience. Set merge.resetDeferredReporting to
/// restore all defaults before applying this patch.
class DeferredReporting {
  groups: Listing<FileGroup>?
  clean: TemplatePair?
  autoFixed: TemplatePair?
  manualFixesNeeded: TemplatePair?
  operationalError: TemplatePair?
  masterUser: String?
  masterAgent: String?
  renderEmptyBuckets: Boolean?
}

/// A field-preserving patch over the stop-time file-activity settings. Every
/// field is optional: a layer that sets one field inherits the others from
/// earlier layers (or the runtime defaults noted below).
class FileActivity {
  /// Infer candidates from project files whose mtimes fall in the unreconciled
  /// interval. This is noisy but useful when tool inspection has gaps.
  /// Default: true.
  filesystemMtime: Boolean?

  /// `git-dirty` is deliberately broad: it can include changes that predate
  /// the agent session. Default: "disabled".
  vcs: ("disabled" | "git-dirty")?

  /// Applied only to the first timestamp scan, whose session-start observation
  /// may occur just after an early edit. Default: 2000.
  timestampToleranceMillis: UInt?

  /// Bound recursive scans and record a coverage gap when the limit is hit.
  /// Default: 100000.
  maxEntries: UInt?

  /// Gaps are reported once, in the Stop that first observes them. Best
  /// effort reports them without blocking; strict also blocks that Stop.
  /// Default: "best-effort".
  coverageGapPolicy: ("best-effort" | "strict")?

  /// Directory basenames pruned from reconciliation, target resolution, and
  /// snapshot walks. Replaces the whole default list when set:
  /// ".agent-hook-kit", ".context", ".direnv", ".git", ".gradle", ".hg",
  /// ".mypy_cache", ".next", ".nox", ".nuxt", ".parcel-cache", ".pytest_cache",
  /// ".ruff_cache", ".svelte-kit", ".svn", ".terraform", ".tox", ".turbo",
  /// ".venv", "__pycache__", "node_modules", "target", and "venv".
  ignoredDirectoryNames: Listing<String>?
}

class Merge {
  /// Drop all prior config state before applying this file.
  resetAll: Boolean = false

  /// Drop selected top-level fields before applying this file.
  reset: Listing<"settings" | "tools" | "run"> = new Listing<"settings" | "tools" | "run"> {}

  /// Drop named tool entries before applying this file.
  resetTools: Listing<String> = new Listing<String> {}

  /// Restore built-in groups/templates before applying this file's optional
  /// deferredReporting patch.
  resetDeferredReporting: Boolean = false
}

class FileSelection {
  include: Listing<String> = new Listing<String> {}
  exclude: Listing<String> = new Listing<String> {}
}

/// Placeholder tokens for argv expansion. Each subclass carries a `type`
/// discriminator so JSON output is self-describing.
abstract class ArgToken {
  type: String
}

class Files extends ArgToken { type = "Files" }
class WorkspaceFiles extends ArgToken { type = "WorkspaceFiles" }
class Workspace extends ArgToken { type = "Workspace" }
class WorkspaceIndicator extends ArgToken { type = "WorkspaceIndicator" }
class ProjectRoot extends ArgToken { type = "ProjectRoot" }
class ToolExecutable extends ArgToken { type = "ToolExecutable" }
class ExtraArgs extends ArgToken { type = "ExtraArgs" }

class ExitCodes {
  clean: Listing<Int> = new Listing<Int> { 0 }
  issues: Listing<Int> = new Listing<Int> {}
  failure: Listing<Int> = new Listing<Int> {}
  unexpected: "failure" | "issues" = "failure"
}

class Diagnostics {
  directory: String?
}

class Messages {
  cleanChangedAgent: String =
    "{{ tool }} changed {{ changed_files | join(\", \") }}; re-read changed files before editing further."
  issuesAgent: String =
    "{{ tool }} reports issues; inspect diagnostics at {{ diagnostics_path }}."
  issuesChangedAgent: String =
    "{{ tool }} changed {{ changed_files | join(\", \") }} and issues remain; re-read changed files, then inspect diagnostics at {{ diagnostics_path }}."
  unavailableUser: String?
  failedUser: String?
}

class Phase {
  mode: "format" | "fix" | "verify" | "check-only"
  program: String?
  argv: Listing<String | ArgToken> = new Listing<String | ArgToken> {}
  exitCodes: ExitCodes = new ExitCodes {}
  writes: "none" | "target-files" | "matching-globs" | "workspace" = "none"
  enabled: Boolean = true
  extraArgs: Listing<String> = new Listing<String> {}
}

/// One command in a deferred check/remedy workflow.
class WorkflowCommand {
  program: String?
  argv: Listing<String | ArgToken> = new Listing<String | ArgToken> {}
  exitCodes: ExitCodes = new ExitCodes {}
  /// Treat non-whitespace stdout on an otherwise-clean exit as source issues.
  /// This supports tools such as gofmt whose non-mutating list mode reports
  /// dirty files through stdout while retaining exit status zero.
  issuesOnStdout: Boolean = false
  writes: "none" | "target-files" | "matching-globs" | "workspace" = "none"
  extraArgs: Listing<String> = new Listing<String> {}
}

/// Stop-time workflow. `check` is required for authoritative explicit
/// workflows and is optional in the schema only so validation can report a
/// useful configuration error before any external command runs.
class Workflow {
  check: WorkflowCommand?
  remedy: WorkflowCommand?
  checkScope: "target-files" | "workspace" = "target-files"
  invocation: "per-file" | "batch" | "workspace" = "batch"
  enabled: Boolean = true
}

class ToolSpec {
  id: String
  displayName: String
  executable: String
  installHint: String?
  files: FileSelection = new FileSelection {}
  workspaceIndicator: String?
  /// Preferred Stop-time check/remedy workflows. When empty, the deferred
  /// runner compatibility-translates `phases`; immediate PostToolUse continues
  /// to execute `phases` exactly as before.
  workflows: Mapping<String, Workflow> = new Mapping<String, Workflow> {}
  /// Optional explicit workflow ordering. Workflows not listed run afterwards
  /// in alphabetical order of their ids; Pkl mapping order is not preserved.
  workflowOrder: Listing<String> = new Listing<String> {}
  /// Nonempty only when a catalog entry has no authoritative read-only check
  /// and must retain the legacy mutator-first compatibility behavior. Built-in
  /// validation rejects such entries unless this limitation is explicit.
  unverifiedRemedyFallback: String?
  phases: Mapping<String, Phase> = new Mapping<String, Phase> {}
  /// Optional explicit phase ordering. Phases not listed run afterwards,
  /// sorted by mode ("format", then "fix", "verify", "check-only") and then
  /// alphabetically by id; Pkl mapping insertion order is not preserved.
  /// List same-mode phases here when their relative order matters.
  phaseOrder: Listing<String> = new Listing<String> {}
  messages: Messages = new Messages {}
  diagnostics: Diagnostics = new Diagnostics {}
  enabled: Boolean = true
}

settings: Settings = new Settings {}
merge: Merge = new Merge {}
tools: Mapping<String, ToolSpec> = new Mapping<String, ToolSpec> {}
run: Listing<String> = new Listing<String> {}
