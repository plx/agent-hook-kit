/// mix format — Elixir code formatter.
///
/// Operates on a Mix project, identified by `mix.exs` at the project root.
/// Runs from the project root so `.formatter.exs` and dependency configs are
/// picked up.

module agent_hook_kit.builtins.tools.MixFmt

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "mix-fmt"
  displayName = "mix format"
  executable = "mix"
  installHint = "install Elixir (e.g. `brew install elixir`) so `mix` is available"
  workspaceIndicator = "mix.exs"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.ex"; "**/*.ex"
      "*.exs"; "**/*.exs"
      "*.heex"; "**/*.heex"
    }
    exclude = new Listing<String> { "deps/**/*"; "_build/**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "format"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        unexpected = "failure"
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "format"
        "--check-formatted"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }
}
