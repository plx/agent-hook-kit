/// golangci-lint — meta-linter that runs many Go linters at once.

module agent_hook_kit.builtins.tools.GolangciLint

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "golangci-lint"
  displayName = "golangci-lint"
  executable = "golangci-lint"
  installHint = "install golangci-lint with `brew install golangci-lint`"
  workspaceIndicator = "go.mod"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.go"; "**/*.go" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "run"
        "--fix"
        new Config.ExtraArgs {}
        "./..."
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        unexpected = "failure"
      }
      writes = "matching-globs"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "run"
        new Config.ExtraArgs {}
        "./..."
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }
}
