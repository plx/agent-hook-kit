/// check-merge-conflict — detect leftover Git merge conflict markers.
///
/// `hk` ships this behind `hk util check-merge-conflict --assume-in-merge`,
/// which is a small native scanner. The semantics are simple enough that a
/// portable `grep -lE` invocation produces the same result for the standard
/// markers (`<<<<<<< `, `=======`, `>>>>>>> `, plus the rarer `||||||| `
/// hunk separator), so we translate this one directly. grep's exit codes
/// map cleanly: `0` = matches found (issues), `1` = no matches (clean),
/// `2` = read or regex error (failure).

module agent_hook_kit.builtins.tools.CheckMergeConflict

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "check-merge-conflict"
  displayName = "check-merge-conflict"
  executable = "grep"
  installHint = "grep is part of any POSIX environment"

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "-lE"
        #"^(<{7} |\|{7} |={7}$|>{7} )"#
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 1 }
        issues = new Listing<Int> { 0 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
