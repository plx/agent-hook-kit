/// nil — Nix language server. Surfaces diagnostics via the `nil diagnostics`
/// subcommand when used as a CLI.
///
/// DRAFT: nil is primarily an LSP. The CLI `diagnostics` subcommand exists
/// (per the hk reference) but is not the recommended invocation in most
/// projects. Exit-code policy is inferred. Verify before relying on this in
/// production.

module agent_hook_kit.builtins.tools.Nil

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "nil"
  displayName = "nil"
  executable = "nil"
  installHint = "install nil with `nix-env -iA nixpkgs.nil` or `cargo install --git https://github.com/oxalica/nil`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.nix"; "**/*.nix" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "diagnostics"
        "--deny-warnings"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
