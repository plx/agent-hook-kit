/// sort-package-json — keep keys in `package.json` files in canonical order.

module agent_hook_kit.builtins.tools.SortPackageJson

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "sort-package-json"
  displayName = "sort-package-json"
  executable = "sort-package-json"
  installHint = "install sort-package-json with `npm install --global sort-package-json`"

  files = new Config.FileSelection {
    include = new Listing<String> { "package.json"; "**/package.json" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }
}
