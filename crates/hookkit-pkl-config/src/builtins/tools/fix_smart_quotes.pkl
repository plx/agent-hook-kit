/// fix-smart-quotes — replace typographic quotes with plain ASCII quotes.
///
// DRAFT: hk implements check + fix inside the hk binary (`hk util
// fix-smart-quotes`), covering U+2018/U+2019/U+201C/U+201D plus their
// full-width variants. A `sed` invocation could match the basic four code
// points but would be platform-sensitive (GNU vs BSD sed). The cleanest
// portable route is `perl -CSD -pi -e 'tr/...//;'` wrapped in `bash -c`,
// which is awkward enough that we are punting until either a hookkit-
// native helper exists or a project opts into a bash-as-executable phase.

module agent_hook_kit.builtins.tools.FixSmartQuotes

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "fix-smart-quotes"
  displayName = "fix-smart-quotes"
  executable = "perl"
  installHint = "perl ships with macOS and most Linux distributions"
  enabled = false

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {}
  phaseOrder = new Listing<String> {}
}
