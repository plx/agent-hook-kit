/// check-case-conflict — detect filenames that only differ in case.
///
// DRAFT: hk implements this inside its own binary by enumerating the git
// index (or the candidate path list) and lowercasing every entry to find
// duplicates. There is no single-`executable` + argv invocation that does
// the same job portably: the natural shell pipeline is
// `git ls-files | awk '{print tolower($0)}' | sort | uniq -d`, which needs
// to be wrapped in `bash -c`, and it is fundamentally a repo-scope rather
// than per-file check. Left as DRAFT until we ship a hookkit-native helper.

module agent_hook_kit.builtins.tools.CheckCaseConflict

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "check-case-conflict"
  displayName = "check-case-conflict"
  executable = "git"
  installHint = "install git from your platform's package manager"
  enabled = false

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {}
  phaseOrder = new Listing<String> {}
}
