/// byte-order-marker — strip UTF-8 BOM (`U+FEFF`) from text files.
///
// DRAFT: hk wraps this behind `hk util check-byte-order-marker` and
// `hk util fix-byte-order-marker`, both implemented inside the hk binary
// using random-access byte I/O. There is no portable single-executable
// command to detect-and-strip a BOM across all the platforms we care about
// (`sed`/`awk` get awkward fast; `perl -CSD -pe ...` is best but assumes
// Perl with the right Unicode flags). Left as DRAFT until we ship a
// hookkit-native helper or settle on a sed/perl invocation.

module agent_hook_kit.builtins.tools.ByteOrderMarker

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "byte-order-marker"
  displayName = "byte-order-marker"
  executable = "perl"
  installHint = "perl ships with macOS and most Linux distributions"
  enabled = false

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {}
  phaseOrder = new Listing<String> {}
}
