/// check-symlinks — flag broken symlinks.
///
// DRAFT: hk's `hk util check-symlinks` walks each candidate path with
// `Path::symlink_metadata` + `Path::exists`. We could approximate the same
// thing with `test -L "$f" && ! test -e "$f"` per file, but expressing that
// loop within our single-`executable` + argv Phase model requires wrapping
// in `bash -c '<script>'`. `find` is not a clean fit either because it
// expects directory roots, not an explicit list of paths. Left as DRAFT
// until we ship a hookkit-native helper or accept a bash-as-executable
// phase.

module agent_hook_kit.builtins.tools.CheckSymlinks

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "check-symlinks"
  displayName = "check-symlinks"
  executable = "bash"
  installHint = "bash is part of any POSIX environment"
  enabled = false

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {}
  phaseOrder = new Listing<String> {}
}
