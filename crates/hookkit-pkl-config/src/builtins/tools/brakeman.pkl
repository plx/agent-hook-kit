/// Brakeman — security scanner for Ruby on Rails applications.
///
/// Brakeman scans the entire Rails project rather than individual files, so
/// the runner invokes it against the project root whenever any tracked Ruby
/// file changes.

module agent_hook_kit.builtins.tools.Brakeman

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "brakeman"
  displayName = "Brakeman"
  executable = "brakeman"
  installHint = "install brakeman with `gem install brakeman` or add it to the project Gemfile"
  workspaceIndicator = "Gemfile"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.rb"; "**/*.rb"; "*.erb"; "**/*.erb" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--quiet"
        "--no-progress"
        "--no-summary"
        "-p"
        new Config.ProjectRoot {}
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 3 }
        unexpected = "failure"
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
