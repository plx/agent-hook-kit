/// gitleaks — secret scanner for source trees.

module agent_hook_kit.builtins.tools.Gitleaks

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "gitleaks"
  displayName = "gitleaks"
  executable = "gitleaks"
  installHint = "install gitleaks with `brew install gitleaks`"

  // Scan any text file by default; tighten in project config if needed.
  files = new Config.FileSelection {
    include = new Listing<String> { "*"; "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      // `--no-color` keeps the diagnostic output ANSI-free; `--verbose`
      // surfaces individual findings; `--no-banner` suppresses the splash.
      argv = new Listing<String | Config.ArgToken> {
        "dir"
        "--redact"
        "--verbose"
        "--no-color"
        "--no-banner"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
