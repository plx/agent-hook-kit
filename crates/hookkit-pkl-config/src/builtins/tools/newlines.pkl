/// newlines — ensure every text file ends with a single trailing newline.
///
// DRAFT: hk ships this behind `hk util end-of-file-fixer`. The classic
// pre-commit implementation is a multi-step shell script that appends a
// newline if missing and trims excess trailing blank lines. There is no
// single binary that does this portably, so it does not translate cleanly
// to our single-`executable` + argv Phase schema. Options:
//   * `bash -c 'for f in "$@"; do tail -c1 "$f" | read -r _ || echo >> "$f"; done' --`
//     — works, but ugly install hint and brittle around CRLF files.
//   * ship a `hookkit util newlines` helper in a follow-up.
// Left as DRAFT pending one of those.

module agent_hook_kit.builtins.tools.Newlines

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "newlines"
  displayName = "newlines"
  executable = "bash"
  installHint = "bash is part of any POSIX environment"
  enabled = false

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {}
  phaseOrder = new Listing<String> {}
}
