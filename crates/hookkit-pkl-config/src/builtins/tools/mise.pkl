/// mise — mise-en-place's built-in TOML formatter for its own config files.

module agent_hook_kit.builtins.tools.Mise

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "mise"
  displayName = "mise fmt"
  executable = "mise"
  installHint = "install mise with `brew install mise`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "mise.toml"
      "mise.*.toml"
      ".mise.toml"
      ".mise.*.toml"
      "mise/config.toml"
      "mise/config.*.toml"
      ".mise/config.toml"
      ".mise/config.*.toml"
      ".config/mise.toml"
      ".config/mise.*.toml"
      ".config/mise/config.toml"
      ".config/mise/config.*.toml"
      ".config/mise/mise.toml"
      ".config/mise/mise.*.toml"
      ".config/mise/conf.d/*.toml"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "fmt"
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "matching-globs"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "fmt"
        "--check"
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }
}
