/// Harper — grammar checker for prose and documentation (harper-cli).
///
/// DRAFT: harper-cli prints a "Note: ... user dictionary at <HOME>/..." line
/// on every invocation that leaks the user's home directory, which makes
/// goldens environment-fragile. The spec is correct and the runner exercises
/// it; we don't ship a fixture until harper-cli grows a way to silence that
/// note (or `--user-dict-path` stops emitting it).

module agent_hook_kit.builtins.tools.Harper

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "harper"
  displayName = "Harper"
  executable = "harper-cli"
  installHint = "install harper with `brew install harper`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.md"; "**/*.md"
      "*.markdown"; "**/*.markdown"
      "*.txt"; "**/*.txt"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--no-color"
        "lint"
        "--format"
        "compact"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
