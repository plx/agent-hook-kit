/// mdschema — schema-based validator for Markdown documents.
///
/// DRAFT: shipped without a vetted fixture because mdschema requires a
/// project-local `.mdschema.yml` and is not commonly installed. Verified
/// against jdx/hk's reference; not exercised by hookkit-tool-runner fixtures
/// yet.

module agent_hook_kit.builtins.tools.Mdschema

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "mdschema"
  displayName = "mdschema"
  executable = "mdschema"
  installHint = "install the mdschema CLI per project documentation"
  workspaceIndicator = ".mdschema.yml"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.md"; "**/*.md"
      "*.markdown"; "**/*.markdown"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
