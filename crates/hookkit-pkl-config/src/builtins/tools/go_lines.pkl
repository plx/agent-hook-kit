/// golines — splits long Go lines.
///
/// `golines --dry-run` is non-mutating and emits diffs on stdout while
/// retaining exit status zero; the deferred workflow classifies that output.

module agent_hook_kit.builtins.tools.GoLines

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "golines"
  displayName = "golines"
  executable = "golines"
  installHint = "install golines with `go install github.com/segmentio/golines@latest`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.go"; "**/*.go" }
  }

  workflows = new Mapping<String, Config.Workflow> {
    ["format"] = new Config.Workflow {
      check = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "--dry-run"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
        }
        issuesOnStdout = true
      }
      remedy = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "-w"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
        }
        writes = "target-files"
      }
      checkScope = "target-files"
      invocation = "batch"
    }
  }
  workflowOrder = new Listing<String> { "format" }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "-w"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
  }
  phaseOrder = new Listing<String> { "format" }
}
