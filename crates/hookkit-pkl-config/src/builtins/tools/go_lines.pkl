/// golines — splits long Go lines.
///
/// `golines --dry-run` exits 0 even when files would change, so the runner
/// relies on the format phase rewriting files and observing the snapshot diff.

module agent_hook_kit.builtins.tools.GoLines

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "golines"
  displayName = "golines"
  executable = "golines"
  installHint = "install golines with `go install github.com/segmentio/golines@latest`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.go"; "**/*.go" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "-w"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
  }
  phaseOrder = new Listing<String> { "format" }
}
