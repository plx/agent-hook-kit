/// trailing-whitespace — strip trailing whitespace from text files.
///
// DRAFT: hk ships this behind `hk util trailing-whitespace` (a Rust helper
// inside the hk binary). The original pre-commit implementation is a sed
// one-liner along the lines of `sed -i 's/[ \t]*$//' "$file"`. Our Phase
// schema expects a single `executable` plus argv, so this would have to be
// invoked via `bash -c '<script>'` to drive a portable sed loop, which is
// awkward to maintain and surfaces a bad install hint to users. Left as a
// DRAFT until we either ship a hookkit-native helper or decide we are
// comfortable with a bash-as-executable phase here.

module agent_hook_kit.builtins.tools.TrailingWhitespace

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "trailing-whitespace"
  displayName = "trailing-whitespace"
  executable = "sed"
  installHint = "sed is part of any POSIX environment"
  enabled = false

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {}
  phaseOrder = new Listing<String> {}
}
