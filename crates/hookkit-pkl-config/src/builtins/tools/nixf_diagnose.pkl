/// nixf-diagnose — Nix linter from libnixf.
///
/// DRAFT: nixf-diagnose is not widely packaged. Exit-code policy is inferred
/// from the hk reference and typical linter conventions. Verify with a real
/// run when `nixf-diagnose` is available before relying on this in production.

module agent_hook_kit.builtins.tools.NixfDiagnose

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "nixf-diagnose"
  displayName = "nixf-diagnose"
  executable = "nixf-diagnose"
  installHint = "install nixf-diagnose via `nix-env -iA nixpkgs.nixf` (ships nixf-diagnose CLI)"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.nix"; "**/*.nix" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
