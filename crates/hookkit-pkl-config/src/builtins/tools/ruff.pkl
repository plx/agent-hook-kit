/// Ruff — Python linter and formatter.

module agent_hook_kit.builtins.tools.Ruff

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "ruff"
  displayName = "Ruff"
  executable = "ruff"
  installHint = "install ruff with `brew install ruff` or add it to the project"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.py"; "**/*.py"; "*.pyi"; "**/*.pyi" }
  }

  workflows = new Mapping<String, Config.Workflow> {
    ["lint"] = new Config.Workflow {
      check = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "check"
          "--force-exclude"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          issues = new Listing<Int> { 1 }
          failure = new Listing<Int> { 2 }
        }
      }
      remedy = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "check"
          "--force-exclude"
          "--fix"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          issues = new Listing<Int> { 1 }
          failure = new Listing<Int> { 2 }
        }
        writes = "target-files"
      }
      checkScope = "target-files"
      invocation = "batch"
    }
    ["format"] = new Config.Workflow {
      check = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "format"
          "--quiet"
          "--force-exclude"
          "--check"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          issues = new Listing<Int> { 1 }
          failure = new Listing<Int> { 2 }
        }
      }
      remedy = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "format"
          "--quiet"
          "--force-exclude"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          failure = new Listing<Int> { 2 }
        }
        writes = "target-files"
      }
      checkScope = "target-files"
      invocation = "batch"
    }
  }
  // Lint fixes can change layout, so when both checks are initially dirty the
  // bounded remedy pass runs lint before formatting, then verifies both.
  workflowOrder = new Listing<String> { "lint"; "format" }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "format"
        "--quiet"
        "--force-exclude"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        failure = new Listing<Int> { 2 }
      }
      writes = "target-files"
    }
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "check"
        "--force-exclude"
        "--fix"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "check"
        "--force-exclude"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
        failure = new Listing<Int> { 2 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "fix"; "verify" }
}
