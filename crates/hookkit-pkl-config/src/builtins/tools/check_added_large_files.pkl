/// check-added-large-files — block commits that add files above a size limit.
///
// DRAFT: hk's implementation walks the git index (or the candidate file list)
// and rejects anything above 500 KB by default. The check is conceptually
// per-file but practically a repo-scope guard: it wants `git ls-files` /
// `git diff --cached` output and a size-threshold flag, neither of which fit
// cleanly into our post-tool-use Phase model (single executable + argv over
// a list of paths). It is also fundamentally a *pre*-commit hook concern;
// a post-tool-use hook fires after every edit and would re-warn on the same
// large file repeatedly. Left as DRAFT until we either add a repo-scope
// hook kind or ship a hookkit-native helper.

module agent_hook_kit.builtins.tools.CheckAddedLargeFiles

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "check-added-large-files"
  displayName = "check-added-large-files"
  executable = "git"
  installHint = "install git from your platform's package manager"
  enabled = false

  files = new Config.FileSelection {
    include = new Listing<String> { "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {}
  phaseOrder = new Listing<String> {}
}
