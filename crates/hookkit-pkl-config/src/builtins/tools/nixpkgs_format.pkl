/// nixpkgs-fmt — the nixpkgs project's Nix formatter.
///
/// DRAFT: exit-code policy is inferred from the hk reference and typical
/// formatter conventions. Verify with a real run when `nixpkgs-fmt` is
/// available before relying on this in production.

module agent_hook_kit.builtins.tools.NixpkgsFormat

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "nixpkgs-fmt"
  displayName = "nixpkgs-fmt"
  executable = "nixpkgs-fmt"
  installHint = "install nixpkgs-fmt with `nix-env -iA nixpkgs.nixpkgs-fmt`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.nix"; "**/*.nix" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "--check"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }
}
