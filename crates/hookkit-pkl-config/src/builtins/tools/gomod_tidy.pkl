/// go mod tidy — keep go.mod and go.sum in sync with the source tree.

module agent_hook_kit.builtins.tools.GomodTidy

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "gomod-tidy"
  displayName = "go mod tidy"
  executable = "go"
  installHint = "install the Go toolchain (go mod tidy ships with it)"
  workspaceIndicator = "go.mod"

  files = new Config.FileSelection {
    include = new Listing<String> { "go.mod"; "**/go.mod"; "go.sum"; "**/go.sum" }
  }

  workflows = new Mapping<String, Config.Workflow> {
    ["tidy"] = new Config.Workflow {
      check = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "mod"
          "tidy"
          "-diff"
          new Config.ExtraArgs {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          issues = new Listing<Int> { 1 }
          failure = new Listing<Int> { 2 }
          unexpected = "failure"
        }
      }
      remedy = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "mod"
          "tidy"
          new Config.ExtraArgs {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          failure = new Listing<Int> { 2 }
          unexpected = "failure"
        }
        writes = "workspace"
      }
      checkScope = "workspace"
      invocation = "workspace"
    }
  }
  workflowOrder = new Listing<String> { "tidy" }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "mod"
        "tidy"
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        unexpected = "failure"
      }
      writes = "workspace"
    }
  }
  phaseOrder = new Listing<String> { "format" }
}
