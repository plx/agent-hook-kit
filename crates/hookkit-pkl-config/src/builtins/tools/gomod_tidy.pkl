/// go mod tidy — keep go.mod and go.sum in sync with the source tree.

module agent_hook_kit.builtins.tools.GomodTidy

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "gomod-tidy"
  displayName = "go mod tidy"
  executable = "go"
  installHint = "install the Go toolchain (go mod tidy ships with it)"
  workspaceIndicator = "go.mod"

  files = new Config.FileSelection {
    include = new Listing<String> { "go.mod"; "**/go.mod"; "go.sum"; "**/go.sum" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "mod"
        "tidy"
        new Config.ExtraArgs {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        unexpected = "failure"
      }
      writes = "workspace"
    }
  }
  phaseOrder = new Listing<String> { "format" }
}
