/// yq — YAML processor used here as an in-place pretty-printer.
///
/// The deferred check pretty-prints one file to a temporary file and compares
/// it without changing the source. The immediate phase remains in place for
/// PostToolUse compatibility.

module agent_hook_kit.builtins.tools.Yq

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "yq"
  displayName = "yq"
  executable = "yq"
  installHint = "install yq with `brew install yq`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "*.yaml"; "**/*.yaml"
      "*.yml"; "**/*.yml"
    }
  }

  workflows = new Mapping<String, Config.Workflow> {
    ["format"] = new Config.Workflow {
      check = new Config.WorkflowCommand {
        program = "sh"
        argv = new Listing<String | Config.ArgToken> {
          "-c"
          "tool=$1; file=$2; shift 3; tmp=$(mktemp \"${TMPDIR:-/tmp}/hookkit-yq.XXXXXX\") || exit 2; trap 'rm -f \"$tmp\"' 0 HUP INT TERM; \"$tool\" -P \"$@\" \"$file\" >\"$tmp\" || exit 2; diff -u \"$file\" \"$tmp\""
          "yq-check"
          new Config.ToolExecutable {}
          new Config.Files {}
          "--"
          new Config.ExtraArgs {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
          issues = new Listing<Int> { 1 }
          failure = new Listing<Int> { 2 }
          unexpected = "failure"
        }
      }
      remedy = new Config.WorkflowCommand {
        argv = new Listing<String | Config.ArgToken> {
          "-iP"
          new Config.ExtraArgs {}
          new Config.Files {}
        }
        exitCodes = new Config.ExitCodes {
          clean = new Listing<Int> { 0 }
        }
        writes = "target-files"
      }
      checkScope = "target-files"
      invocation = "per-file"
    }
  }
  workflowOrder = new Listing<String> { "format" }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "-iP"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
  }
  phaseOrder = new Listing<String> { "format" }
}
