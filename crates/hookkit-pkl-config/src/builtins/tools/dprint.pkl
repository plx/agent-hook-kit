/// dprint — pluggable, multi-language code formatter.
///
/// dprint relies on a project-local `dprint.json` config to decide which
/// plugins handle which extensions. The spec mirrors hk's broad glob and
/// lets dprint decide what to actually format.

module agent_hook_kit.builtins.tools.Dprint

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "dprint"
  displayName = "dprint"
  executable = "dprint"
  installHint = "install dprint with `brew install dprint`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*"; "**/*" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "fmt"
        "--allow-no-files"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "check"
        "--allow-no-files"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        // dprint exits 20 to report files needing formatting in `check` mode.
        issues = new Listing<Int> { 20 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }
}
