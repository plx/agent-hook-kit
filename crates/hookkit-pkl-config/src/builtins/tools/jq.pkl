/// jq — JSON processor.
///
/// hk's recipes are multi-line bash pipelines (per-file stdout-to-tempfile and
/// `diff -u`) that the single-argv runtime can't express directly. We expose a
/// verify-only phase that asks `jq` to parse each file: `jq empty <file>`
/// exits 0 for valid JSON and non-zero only on a parse or read error. The
/// phase runs once per file because jq parses all of its file arguments as one
/// concatenated JSON stream: `{"a":` and `1}` in two files would pass
/// together, and two files holding `true` without a trailing newline would
/// fail together. `-e` must not be used: `empty` produces no output, so
/// `jq -e empty` exits 4 for every valid file. Parse errors exit 2 before
/// jq 1.7 and 5 from jq 1.7 on (where 2 also covers unreadable files). Use the
/// `taplo`/`prettier`-style formatters for actual rewriting.

module agent_hook_kit.builtins.tools.Jq

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "jq"
  displayName = "jq"
  executable = "jq"
  installHint = "install jq with `brew install jq`"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.json"; "**/*.json" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "empty"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 2; 5 }
      }
      invocation = "per-file"
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
