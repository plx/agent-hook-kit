/// vacuum — fast OpenAPI / Swagger specification linter.

module agent_hook_kit.builtins.tools.Vacuum

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "vacuum"
  displayName = "vacuum"
  executable = "vacuum"
  installHint = "install vacuum with `brew install daveshanley/vacuum/vacuum`"

  // Only target files that look like OpenAPI / Swagger specs by name. Tighten
  // or override in project config if your specs live elsewhere.
  files = new Config.FileSelection {
    include = new Listing<String> {
      "*openapi*.yaml"; "**/*openapi*.yaml"
      "*openapi*.yml"; "**/*openapi*.yml"
      "*openapi*.json"; "**/*openapi*.json"
      "*swagger*.yaml"; "**/*swagger*.yaml"
      "*swagger*.yml"; "**/*swagger*.yml"
      "*swagger*.json"; "**/*swagger*.json"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "lint"
        "--no-banner"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 1 }
      }
    }
  }
  phaseOrder = new Listing<String> { "verify" }
}
