/// buildifier (lint) — linter for Bazel BUILD, WORKSPACE, and Starlark files.

module agent_hook_kit.builtins.tools.BuildifierLint

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "buildifier-lint"
  displayName = "buildifier lint"
  executable = "buildifier"
  installHint = "install buildifier with `brew install buildifier`"

  files = new Config.FileSelection {
    include = new Listing<String> {
      "BUILD"; "**/BUILD"
      "BUILD.bazel"; "**/BUILD.bazel"
      "WORKSPACE"; "WORKSPACE.bazel"
      "MODULE.bazel"
      "*.bzl"; "**/*.bzl"
      "*.star"; "**/*.star"
      "*.sky"; "**/*.sky"
    }
  }

  phases = new Mapping<String, Config.Phase> {
    ["fix"] = new Config.Phase {
      mode = "fix"
      argv = new Listing<String | Config.ArgToken> {
        "-lint=fix"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 4 }
      }
      writes = "target-files"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "-mode=check"
        "-lint=warn"
        new Config.ExtraArgs {}
        new Config.Files {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 4 }
      }
    }
  }
  phaseOrder = new Listing<String> { "fix"; "verify" }
}
