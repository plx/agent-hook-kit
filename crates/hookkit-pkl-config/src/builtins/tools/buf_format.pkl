/// buf format — Protocol Buffers formatter.

module agent_hook_kit.builtins.tools.BufFormat

import "../Config.pkl" as Config

spec: Config.ToolSpec = new Config.ToolSpec {
  id = "buf-format"
  displayName = "buf format"
  executable = "buf"
  installHint = "install buf with `brew install buf`"
  workspaceIndicator = "buf.yaml"

  files = new Config.FileSelection {
    include = new Listing<String> { "*.proto"; "**/*.proto" }
  }

  phases = new Mapping<String, Config.Phase> {
    ["format"] = new Config.Phase {
      mode = "format"
      argv = new Listing<String | Config.ArgToken> {
        "format"
        "--write"
        new Config.ExtraArgs {}
        new Config.Workspace {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
      }
      writes = "matching-globs"
    }
    ["verify"] = new Config.Phase {
      mode = "verify"
      argv = new Listing<String | Config.ArgToken> {
        "format"
        "--diff"
        "--exit-code"
        new Config.ExtraArgs {}
        new Config.Workspace {}
      }
      exitCodes = new Config.ExitCodes {
        clean = new Listing<Int> { 0 }
        issues = new Listing<Int> { 100 }
      }
    }
  }
  phaseOrder = new Listing<String> { "format"; "verify" }
}
