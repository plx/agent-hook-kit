{
  "$id": "urn:agent-hook-kit:contracts:claude-code:docs-2026-09-30-r1:task-created:command-output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "continue": {
      "type": "boolean"
    },
    "decision": {
      "const": "block"
    },
    "reason": {
      "description": "Returned to Claude as the TaskCreate tool error when decision is block.",
      "type": "string"
    },
    "stopReason": {
      "description": "Shown to the user when continue is false; it stays in the conversation, so Claude sees it if the conversation continues.",
      "type": "string"
    },
    "suppressOutput": {
      "description": "Accepted but has no effect.",
      "type": "boolean"
    },
    "systemMessage": {
      "type": "string"
    },
    "terminalSequence": {
      "type": "string"
    }
  },
  "type": "object"
}
