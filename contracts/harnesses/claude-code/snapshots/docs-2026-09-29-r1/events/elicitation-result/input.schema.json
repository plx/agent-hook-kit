{
  "$id": "urn:agent-hook-kit:contracts:claude-code:docs-2026-09-29-r1:elicitation-result:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "action": {
      "enum": [
        "accept",
        "decline",
        "cancel"
      ]
    },
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "content": {
      "type": "object"
    },
    "cwd": {
      "type": "string"
    },
    "effort": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "required": [
        "level"
      ],
      "type": "object"
    },
    "elicitation_id": {
      "type": "string"
    },
    "hook_event_name": {
      "const": "ElicitationResult"
    },
    "mcp_server_name": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "form",
        "url"
      ]
    },
    "permission_mode": {
      "enum": [
        "default",
        "plan",
        "acceptEdits",
        "auto",
        "dontAsk",
        "bypassPermissions"
      ]
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "description": "Session scratchpad directory; absent when the session has none or the temp directory is unavailable (Claude Code v2.1.257 or later).",
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "mcp_server_name",
    "action"
  ],
  "type": "object"
}
