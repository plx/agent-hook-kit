{
  "$id": "urn:agent-hook-kit:contracts:claude-code:docs-2026-09-29-r1:post-model-switch:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "cache_ttl": {
      "enum": [
        "5m",
        "1h"
      ]
    },
    "context_tokens": {
      "minimum": 0,
      "type": "integer"
    },
    "cwd": {
      "type": "string"
    },
    "effort": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "required": [
        "level"
      ],
      "type": "object"
    },
    "estimated_cache_write_usd": {
      "minimum": 0,
      "type": "number"
    },
    "from_model": {
      "type": "string"
    },
    "hook_event_name": {
      "const": "PostModelSwitch"
    },
    "permission_mode": {
      "enum": [
        "default",
        "plan",
        "acceptEdits",
        "auto",
        "dontAsk",
        "bypassPermissions"
      ]
    },
    "pricing": {
      "enum": [
        "configured",
        "catalog",
        "default"
      ]
    },
    "prompt_cache_warm": {
      "type": "boolean"
    },
    "prompt_id": {
      "type": "string"
    },
    "requested_model": {
      "type": [
        "string",
        "null"
      ]
    },
    "scratchpad_dir": {
      "description": "Session scratchpad directory; absent when the session has none or the temp directory is unavailable (Claude Code v2.1.257 or later).",
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "source": {
      "enum": [
        "command",
        "picker",
        "sdk",
        "auto",
        "resume"
      ]
    },
    "to_model": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "from_model",
    "to_model",
    "requested_model",
    "source",
    "context_tokens",
    "prompt_cache_warm",
    "cache_ttl",
    "estimated_cache_write_usd",
    "pricing"
  ],
  "type": "object"
}
