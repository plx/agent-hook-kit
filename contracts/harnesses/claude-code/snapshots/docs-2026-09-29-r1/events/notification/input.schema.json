{
  "$id": "urn:agent-hook-kit:contracts:claude-code:docs-2026-09-29-r1:notification:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "effort": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "required": [
        "level"
      ],
      "type": "object"
    },
    "hook_event_name": {
      "const": "Notification"
    },
    "message": {
      "type": "string"
    },
    "notification_type": {
      "examples": [
        "permission_prompt",
        "idle_prompt",
        "auth_success",
        "elicitation_dialog",
        "elicitation_url_dialog",
        "elicitation_complete",
        "elicitation_response",
        "agent_needs_input",
        "agent_completed",
        "quota_auto_resume_fired",
        "quota_auto_resume_stale",
        "quota_auto_resume_disabled"
      ],
      "type": "string"
    },
    "permission_mode": {
      "enum": [
        "default",
        "plan",
        "acceptEdits",
        "auto",
        "dontAsk",
        "bypassPermissions"
      ]
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "description": "Session scratchpad directory; absent when the session has none or the temp directory is unavailable (Claude Code v2.1.257 or later).",
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "message",
    "notification_type"
  ],
  "type": "object"
}
