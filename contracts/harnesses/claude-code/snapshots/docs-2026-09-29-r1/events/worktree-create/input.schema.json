{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hook-kit:contracts:claude-code:docs-2026-09-29-r1:worktree-create:input",
  "type": "object",
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "name"
  ],
  "properties": {
    "session_id": {
      "type": "string"
    },
    "prompt_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "scratchpad_dir": {
      "type": "string",
      "description": "Session scratchpad directory; absent when the session has none or the temp directory is unavailable (Claude Code v2.1.257 or later)."
    },
    "permission_mode": {
      "enum": [
        "default",
        "plan",
        "acceptEdits",
        "auto",
        "dontAsk",
        "bypassPermissions"
      ]
    },
    "effort": {
      "type": "object",
      "required": [
        "level"
      ],
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "additionalProperties": false
    },
    "hook_event_name": {
      "const": "WorktreeCreate"
    },
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
