{
  "$id": "urn:agent-hook-kit:contracts:claude-code:docs-2026-09-29-r1:pre-tool-use:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "cwd": {
      "type": "string"
    },
    "effort": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "enum": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ]
        }
      },
      "required": [
        "level"
      ],
      "type": "object"
    },
    "hook_event_name": {
      "const": "PreToolUse"
    },
    "mcp_server": {
      "additionalProperties": true,
      "description": "Present only for MCP tools (Claude Code v2.1.274 or later). The source vocabulary is open.",
      "properties": {
        "name": {
          "type": "string"
        },
        "source": {
          "examples": [
            "sdk",
            "plugin",
            "user",
            "project",
            "local",
            "dynamic",
            "managed",
            "enterprise",
            "claudeai",
            "agent"
          ],
          "type": "string"
        }
      },
      "required": [
        "name",
        "source"
      ],
      "type": "object"
    },
    "permission_mode": {
      "enum": [
        "default",
        "plan",
        "acceptEdits",
        "auto",
        "dontAsk",
        "bypassPermissions"
      ]
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "description": "Session scratchpad directory; absent when the session has none or the temp directory is unavailable (Claude Code v2.1.257 or later).",
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "tool_input": {},
    "tool_name": {
      "type": "string"
    },
    "tool_use_id": {
      "type": "string"
    },
    "transcript_path": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "tool_name",
    "tool_input",
    "tool_use_id"
  ],
  "type": "object"
}
