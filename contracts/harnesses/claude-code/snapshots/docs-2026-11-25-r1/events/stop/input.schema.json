{
  "$id": "urn:agent-hook-kit:contracts:claude-code:docs-2026-11-25-r1:stop:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "background_tasks": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "agent_type": {
            "description": "Present only for subagent tasks.",
            "type": "string"
          },
          "command": {
            "description": "Present only for shell tasks and monitor tasks that run a command.",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "description": "Present only for workflow tasks.",
            "type": "string"
          },
          "server": {
            "description": "Present only for monitor and MCP task tasks.",
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "tool": {
            "description": "Present only for monitor and MCP task tasks.",
            "type": "string"
          },
          "type": {
            "description": "Friendly task-type label; falls back to the raw discriminant for unrecognized types. A Monitor's script is labeled monitor since Claude Code v2.1.329.",
            "examples": [
              "shell",
              "subagent",
              "monitor",
              "workflow",
              "teammate",
              "cloud session",
              "MCP task"
            ],
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "status",
          "description"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "cwd": {
      "type": "string"
    },
    "effort": {
      "additionalProperties": true,
      "properties": {
        "level": {
          "description": "Open string: the Agent SDK types it as string; the examples are the documented levels.",
          "examples": [
            "low",
            "medium",
            "high",
            "xhigh",
            "max"
          ],
          "type": "string"
        }
      },
      "required": [
        "level"
      ],
      "type": "object"
    },
    "hook_event_name": {
      "const": "Stop"
    },
    "last_assistant_message": {
      "type": "string"
    },
    "permission_mode": {
      "description": "Open string: the Agent SDK types it as string; the examples are the documented modes.",
      "examples": [
        "default",
        "plan",
        "acceptEdits",
        "auto",
        "dontAsk",
        "bypassPermissions"
      ],
      "type": "string"
    },
    "prompt_id": {
      "type": "string"
    },
    "scratchpad_dir": {
      "description": "Session scratchpad directory; absent when the session has none or the temp directory is unavailable (Claude Code v2.1.257 or later).",
      "type": "string"
    },
    "session_crons": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "recurring": {
            "type": "boolean"
          },
          "schedule": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "schedule",
          "recurring",
          "prompt"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "session_id": {
      "type": "string"
    },
    "stop_hook_active": {
      "type": "boolean"
    },
    "transcript_path": {
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "transcript_path",
    "cwd",
    "hook_event_name",
    "stop_hook_active"
  ],
  "type": "object"
}
