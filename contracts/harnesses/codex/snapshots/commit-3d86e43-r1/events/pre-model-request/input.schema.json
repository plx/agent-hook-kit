{
  "$id": "urn:agent-hook-kit:contracts:codex:commit-3d86e43-r1:pre-model-request:input",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "AbsolutePathBuf": {
      "description": "A path that is guaranteed to be absolute and normalized (though it is not guaranteed to be canonicalized or exist on the filesystem).\n\nIMPORTANT: When deserializing an `AbsolutePathBuf`, a base path must be set using [AbsolutePathBufGuard::new]. If no base path is set, the deserialization will fail unless the path being deserialized is already absolute.",
      "type": "string"
    },
    "ModelRequestStatus": {
      "enum": [
        "completed",
        "failed",
        "cancelled"
      ],
      "type": "string"
    },
    "NullableString": {
      "type": [
        "string",
        "null"
      ]
    },
    "SamplingKind": {
      "enum": [
        "sampling",
        "foreground_compaction",
        "background_compaction"
      ],
      "type": "string"
    },
    "TokenUsage": {
      "properties": {
        "cache_write_input_tokens": {
          "default": 0,
          "format": "int64",
          "type": "integer"
        },
        "cached_input_tokens": {
          "format": "int64",
          "type": "integer"
        },
        "input_tokens": {
          "format": "int64",
          "type": "integer"
        },
        "output_tokens": {
          "format": "int64",
          "type": "integer"
        },
        "reasoning_output_tokens": {
          "format": "int64",
          "type": "integer"
        },
        "total_tokens": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "cached_input_tokens",
        "input_tokens",
        "output_tokens",
        "reasoning_output_tokens",
        "total_tokens"
      ],
      "type": "object"
    }
  },
  "properties": {
    "agent_id": {
      "type": "string"
    },
    "agent_type": {
      "type": "string"
    },
    "attempt_number": {
      "description": "One-based attempt number within this generation.",
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "cwd": {
      "$ref": "#/definitions/AbsolutePathBuf"
    },
    "hook_event_name": {
      "const": "PreModelRequest",
      "type": "string"
    },
    "kind": {
      "$ref": "#/definitions/SamplingKind"
    },
    "model": {
      "type": "string"
    },
    "request_id": {
      "description": "Identifies a generation across harness retries and model fallback.",
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "thread_id": {
      "description": "Identifies the issuing thread within its shared session.",
      "type": "string"
    },
    "transcript_path": {
      "$ref": "#/definitions/NullableString"
    },
    "turn_id": {
      "type": "string"
    }
  },
  "required": [
    "attempt_number",
    "cwd",
    "hook_event_name",
    "kind",
    "model",
    "request_id",
    "session_id",
    "thread_id",
    "transcript_path",
    "turn_id"
  ],
  "title": "model-request.command.input",
  "type": "object"
}
