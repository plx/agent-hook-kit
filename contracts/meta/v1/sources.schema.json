{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hook-kit:contracts:meta:v1:sources",
  "type": "object",
  "required": ["format_version", "sources"],
  "properties": {
    "format_version": { "const": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "kind", "authority", "url", "retrieved"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "minLength": 1 },
          "retrieved": { "type": "string", "format": "date" },
          "revision": { "type": ["string", "null"], "minLength": 1 },
          "content_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "license": { "type": ["string", "null"], "minLength": 1 },
          "reproducibility": {
            "enum": ["vendored", "pinned-revision", "content-hash-only", "unreproducible"]
          },
          "limitations": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
