{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:agent-hook-kit:contracts:meta:v1:snapshot",
  "type": "object",
  "required": ["format_version", "id", "harness", "state", "retrieved", "sources_file", "events"],
  "properties": {
    "format_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "harness": { "type": "string", "minLength": 1 },
    "state": { "enum": ["draft", "frozen"] },
    "retrieved": { "type": "string", "format": "date" },
    "sources_file": { "type": "string", "minLength": 1 },
    "manifest_file": { "const": "MANIFEST.sha256" },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["wire_name", "rust_key", "path"],
        "properties": {
          "wire_name": { "type": "string", "minLength": 1 },
          "rust_key": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "pattern": "^events/[a-z0-9-]+$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
