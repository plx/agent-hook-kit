// {{ project_name }} quality-hook policy.
//
// This package-specific file is passed explicitly to the generated binary;
// it is not part of HookKit's shared `.agent-hook-kit` discovery chain.
amends "Config.pkl"
import "Builtins.pkl"

settings {
  loweringPolicy = {{ lowering_policy | tojson }}
{% if starter == "deferred_quality" or "file_activity" in state_capabilities %}  // Timestamp reconciliation supplies a best-effort lower bound when the
  // harness has no exact SessionStart event (currently Antigravity).
  fileActivity {
    filesystemMtime = true
    vcs = "disabled"
    coverageGapPolicy = {{ reconciliation_posture | tojson }}
  }
{% endif %}}

tools {
{% for tool in quality_tools %}{% if tool == "custom" %}  // Replace the executable, selection, and commands with the project's own
  // formatter or analyzer. Keeping both forms makes this seam usable by the
  // immediate PostToolUse runner and the deferred Stop runner.
  ["custom"] = new ToolSpec {
    id = "custom"
    displayName = "Custom quality check"
    executable = "custom-quality-check"
    installHint = "replace the generated custom tool seam before enabling this hook"
    files {
      include = new Listing { "**/*" }
    }
    phases {
      ["check"] = new Phase {
        mode = "check-only"
        argv = new Listing { new Files {} }
        exitCodes {
          clean = new Listing { 0 }
          issues = new Listing { 1 }
          failure = new Listing { 2 }
        }
      }
    }
    phaseOrder = new Listing { "check" }
    workflows {
      ["check"] = new Workflow {
        check = new WorkflowCommand {
          argv = new Listing { new Files {} }
          exitCodes {
            clean = new Listing { 0 }
            issues = new Listing { 1 }
            failure = new Listing { 2 }
          }
        }
        checkScope = "target-files"
        invocation = "batch"
      }
    }
    workflowOrder = new Listing { "check" }
  }
{% elif tool == "gofmt" %}  ["gofmt"] = Builtins.goFmt
{% else %}  [{{ tool | tojson }}] = Builtins.{{ tool }}
{% endif %}{% endfor %}}

run = new Listing {
{% for tool in quality_tools %}  {{ tool | tojson }}
{% endfor %}}
