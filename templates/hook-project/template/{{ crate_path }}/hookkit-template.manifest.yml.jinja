# Resolved generation choices. Copier's answers file remains authoritative.
{% set preset = namespace(customized=false) -%}
{% set selected_archetype = archetype_catalog.archetypes | selectattr("stable_id", "equalto", starter) | first -%}
{% if starter != "custom" -%}
{% set selected_hooks = aligned_hooks if harness_mode == "cross" else native_hooks -%}
{% set expected_state = selected_archetype.required_state | default([], true) -%}
{% if harness_mode != selected_archetype.default_mode
      or (harness_mode == "cross" and (harnesses | sort) != (selected_archetype.default_harnesses | sort))
      or (harness_mode == "single" and harness != selected_archetype.default_harness)
      or (selected_hooks | sort) != (selected_archetype.required_hooks | sort)
      or (state_capabilities | sort) != (expected_state | sort) -%}
{% set preset.customized = true -%}
{% endif -%}
{% if selected_archetype.runner
      and (lowering_policy != selected_archetype.runner.default_lowering_policy
           or quality_profile != selected_archetype.runner.default_quality_profile
           or (quality_tools | sort) != (selected_archetype.runner.default_quality_tools | sort)
           or quality_config_path != crate_path ~ "/config/" ~ package_name ~ ".pkl"
           or (selected_archetype.runner.kind == "deferred"
               and reconciliation_posture != selected_archetype.runner.default_reconciliation_posture)) -%}
{% set preset.customized = true -%}
{% endif -%}
{% endif -%}
template_version: {{ compatibility.template_version | string | tojson }}
output_mode: {{ output_mode | tojson }}
starter:
  requested: {{ starter | tojson }}
  customized: {{ preset.customized | tojson }}
package:
  name: {{ package_name | tojson }}
  binary: {{ binary_name | tojson }}
  crate_path: {{ crate_path | tojson }}
harness_mode: {{ harness_mode | tojson }}
harnesses:
{% if harness_mode == "cross" -%}
{% for selected_harness in harnesses %}
  - {{ selected_harness | tojson }}
{% endfor -%}
{% else -%}
  - {{ harness | tojson }}
{% endif %}
requested_hooks:
{% if harness_mode == "cross" -%}
{% for hook in aligned_hooks %}
  - {{ hook | tojson }}
{% endfor -%}
{% else -%}
{% for hook in native_hooks %}
  - {{ hook | tojson }}
{% endfor -%}
{% endif %}
effective_hooks:
{% if harness_mode == "cross" -%}
{% for hook in aligned_hooks %}
  - {{ hook | tojson }}
{% endfor -%}
{% if "file_activity" in state_capabilities %}
  - "session_start_state"
{% endif -%}
{% else -%}
{% for hook in native_hooks %}
  - {{ hook | tojson }}
{% endfor -%}
{% endif %}
available_aligned_families:
{% if harness_mode == "cross" -%}
{% for family in alignment_catalog.alignments -%}
{% set availability = namespace(ok=true) -%}
{% for selected_harness in harnesses -%}
{% if selected_harness not in family.supported_harnesses -%}
{% set availability.ok = false -%}
{% endif -%}
{% endfor -%}
{% if availability.ok %}
  - {{ family.stable_id | tojson }}
{% endif -%}
{% endfor -%}
{% else %}  []
{% endif %}
portable_output_floors:
{% if harness_mode == "cross" -%}
{% for selected_hook in aligned_hooks -%}
{% for family in alignment_catalog.alignments -%}
{% if family.stable_id == selected_hook %}
  {{ selected_hook }}: {{ family.portable_floor.output | tojson }}
{% endif -%}
{% endfor -%}
{% endfor -%}
{% else %}  {}
{% endif %}
fidelity:
{% set resolved_harnesses = harnesses if harness_mode == "cross" else [harness] -%}
{% for selected_harness in resolved_harnesses %}
  {{ selected_harness }}:
    native_session_boundary: {{ ("inferred" if selected_harness == "antigravity" else "exact") | tojson }}
    post_tool_input:
      originating_call_arguments: true
      tool_result: {{ (selected_harness != "antigravity") | tojson }}
    post_tool_output_messages: {{ ("none" if selected_harness == "antigravity" else "separate-user-and-agent") | tojson }}
    turn_completion_output_messages: {{ ("single-reason" if selected_harness == "antigravity" else "separate-user-and-agent") | tojson }}
{% if "file_activity" in state_capabilities %}
    file_activity_lower_bound: {{ ("inferred-first-observation" if selected_harness == "antigravity" else "exact-session-start") | tojson }}
{% else %}
    file_activity_lower_bound: null
{% endif -%}
{% endfor -%}
state_capabilities:
{% for capability in state_capabilities %}
  - {{ capability | tojson }}
{% else %}  []
{% endfor -%}
state:
  family: {{ package_name | tojson }}
  family_version: 1
  default_root: {{ ("$TMPDIR/agent-hook-kit/generated/" ~ package_name ~ "/") | tojson }}
lowering_policy: {% if starter in ["immediate_quality", "deferred_quality"] or "file_activity" in state_capabilities %}{{ lowering_policy | tojson }}{% else %}null{% endif %}
{% if starter in ["immediate_quality", "deferred_quality"] or "file_activity" in state_capabilities %}
runner:
  config_path: {{ quality_config_path | tojson }}
  profile: {{ quality_profile | tojson }}
  tools:
{% for tool in quality_tools %}
    - {{ tool | tojson }}
{% endfor -%}
{% if starter == "deferred_quality" or "file_activity" in state_capabilities %}
  reconciliation_posture: {{ reconciliation_posture | tojson }}
{% endif -%}
{% endif -%}
dependency:
  source: {{ dependency_source | tojson }}
{% if dependency_source == "git" %}
  repository: {{ compatibility.hookkit.repository | tojson }}
  revision: {{ hookkit_git_rev | tojson }}
{% elif dependency_source == "crates-io" %}
  version: {{ compatibility.hookkit.crates_io_version | string | tojson }}
{% else %}
  repository_root: {{ hookkit_path | string | tojson }}
{% endif -%}
generated_ci: {% if github_actions %}{{ (".github/workflows/" ~ package_name ~ "-hook-ci.yml") | tojson }}{% else %}null{% endif %}
