{% from "templates/hook-project/template/_macros/rust.jinja" import aligned_base, variant -%}
{% macro handler_state_dir() -%}
{%- if starter == "deferred_quality" or "file_activity" in state_capabilities -%}
Some(state_dir.as_path())
{%- elif state_capabilities -%}
state_dir.as_deref()
{%- else -%}
None
{%- endif -%}
{%- endmacro -%}
{% macro handler_state_dir_owned() -%}
{%- if starter == "deferred_quality" or "file_activity" in state_capabilities -%}
Some(state_dir)
{%- elif state_capabilities -%}
state_dir
{%- else -%}
None
{%- endif -%}
{%- endmacro -%}
use super::cli::{Cli, Command};
{%- if (harness_mode == "cross" and "pre_tool" in aligned_hooks) or
      (harness_mode == "single" and "pre_tool_use" in native_hooks) -%}
{%- if starter not in ["pre_tool_rewrite", "scoped_context_once"] and
      (harness_mode == "cross" or starter != "custom") %}
use crate::hooks::pre_tool::Decision;
{%- endif %}
{%- endif %}

/// Execute one explicit hook command.
#[rustfmt::skip]
pub fn run(cli: Cli) -> std::process::ExitCode {
{%- if harness_mode == "cross" %}
    let harness = cli.harness.id();
{%- endif %}
{%- if starter in ["immediate_quality", "deferred_quality"] or "file_activity" in state_capabilities %}
    let config_path = cli
        .config
        .unwrap_or_else(crate::scaffold::runners::default_config_path);
{%- endif %}
{%- if starter == "deferred_quality" or "file_activity" in state_capabilities %}
    let state_dir = cli
        .state_dir
        .unwrap_or_else(crate::scaffold::runners::default_state_dir);
{%- elif state_capabilities %}
    let state_dir = cli.state_dir;
{%- endif %}
    match cli.command {
{%- if harness_mode == "cross" %}
{%- for stable_id in aligned_hooks %}
{%- if stable_id == "pre_tool" %}
        Command::{{ variant(stable_id) }} => {
            run_pre_tool(harness, {{ handler_state_dir_owned() }})
        },
{%- elif starter == "immediate_quality" and stable_id == "post_tool" %}
        Command::{{ variant(stable_id) }} => {
            crate::scaffold::runners::run_immediate(harness, config_path)
        }
{%- elif "file_activity" in state_capabilities and stable_id == "post_tool" %}
        Command::{{ variant(stable_id) }} => {
            crate::scaffold::runners::run_file_activity(harness, state_dir)
        }
{%- elif "file_activity" in state_capabilities and stable_id == "turn_completion" %}
        Command::{{ variant(stable_id) }} => crate::scaffold::runners::run_turn_completion(
            harness,
            config_path,
            state_dir,
        ),
{%- elif starter == "session_bootstrap" and stable_id == "session_start" %}
        Command::{{ variant(stable_id) }} => hookkit_runtime::aligned::run_aligned_event::<
            hookkit_runtime::aligned::SessionStart,
            _,
        >(harness, move |input, environment, context| {
{%- if "file_activity" in state_capabilities %}
            crate::scaffold::state::ensure_session_state(context, Some(state_dir.as_path()))
                .map_err(std::io::Error::other)?;
{%- else %}
            crate::scaffold::state::ensure_session_state(context, state_dir.as_deref())
                .map_err(std::io::Error::other)?;
{%- endif %}
            let _ = environment;
            match crate::hooks::session_bootstrap::build_context(input.source()) {
                Some(additional_context) => hookkit_common::SessionStartOutput::with_context(
                    context.harness(),
                    additional_context,
                ),
                None => hookkit_common::SessionStartOutput::no_op(context.harness()),
            }
        }),
{%- else %}
        Command::{{ variant(stable_id) }} => hookkit_runtime::aligned::run_aligned_event::<
            hookkit_runtime::aligned::{{ aligned_base(stable_id) }},
            _,
        >(harness, move |input, environment, context| {
            crate::hooks::aligned::{{ stable_id }}(
                input,
                environment,
                context,
                {{ handler_state_dir() }},
            )
        }),
{%- endif %}
{%- endfor %}
{%- if "file_activity" in state_capabilities %}
        Command::SessionStartState => {
{%- if "antigravity" in harnesses %}
            // `Cli::validate` rejects this combination first. Exit status 2
            // can mean "block" to a harness, so fail non-blockingly.
            if harness == hookkit_core::HarnessId::ANTIGRAVITY {
                return std::process::ExitCode::FAILURE;
            }
{%- endif %}
            crate::scaffold::runners::run_session_start(harness, state_dir)
        }
{%- endif %}
{%- else %}
{%- for stable_id in native_hooks %}
{%- if stable_id == "pre_tool_use" and starter == "custom" %}
{%- for event in event_catalog.events %}
{%- if event.harness == harness and event.stable_id == stable_id %}
        Command::{{ variant(stable_id) }} => hookkit_runtime::run_event::<
            {{ event.rust_event }},
            _,
        >(move |input, environment, context| {
            crate::hooks::native::{{ stable_id }}(
                input,
                environment,
                context,
                {{ handler_state_dir() }},
            )
        }),
{%- endif %}
{%- endfor %}
{%- elif stable_id == "pre_tool_use" %}
{%- if starter == "scoped_context_once" %}
{%- if "file_activity" in state_capabilities %}
        Command::{{ variant(stable_id) }} => run_pre_tool(Some(state_dir)),
{%- else %}
        Command::{{ variant(stable_id) }} => run_pre_tool(state_dir),
{%- endif %}
{%- else %}
        Command::{{ variant(stable_id) }} => run_pre_tool(),
{%- endif %}
{%- elif starter == "immediate_quality" and stable_id == "post_tool_use" %}
        Command::{{ variant(stable_id) }} => crate::scaffold::runners::run_immediate(
            {{ "hookkit_core::HarnessId::CLAUDE_CODE" if harness == "claude-code" else ("hookkit_core::HarnessId::CODEX" if harness == "codex" else "hookkit_core::HarnessId::ANTIGRAVITY") }},
            config_path,
        ),
{%- elif "file_activity" in state_capabilities and stable_id == "post_tool_use" %}
        Command::{{ variant(stable_id) }} => crate::scaffold::runners::run_file_activity(
            {{ "hookkit_core::HarnessId::CLAUDE_CODE" if harness == "claude-code" else ("hookkit_core::HarnessId::CODEX" if harness == "codex" else "hookkit_core::HarnessId::ANTIGRAVITY") }},
            state_dir,
        ),
{%- elif "file_activity" in state_capabilities and stable_id == "stop" %}
        Command::{{ variant(stable_id) }} => crate::scaffold::runners::run_turn_completion(
            {{ "hookkit_core::HarnessId::CLAUDE_CODE" if harness == "claude-code" else ("hookkit_core::HarnessId::CODEX" if harness == "codex" else "hookkit_core::HarnessId::ANTIGRAVITY") }},
            config_path,
            state_dir,
        ),
{%- elif "file_activity" in state_capabilities and stable_id == "session_start" and harness != "antigravity" %}
        Command::{{ variant(stable_id) }} => hookkit_runtime::run_event::<
            {{ "hookkit_claude::protocol::SessionStart" if harness == "claude-code" else "hookkit_codex::catalog::SessionStart" }},
            _,
        >(move |input, environment, context| {
            crate::scaffold::state::ensure_session_state(context, Some(state_dir.as_path()))
                .map_err(std::io::Error::other)?;
            crate::hooks::native::session_start(
                input,
                environment,
                context,
                Some(state_dir.as_path()),
            )
        }),
{%- elif "file_activity" in state_capabilities and stable_id == "pre_invocation" and harness == "antigravity" %}
        Command::{{ variant(stable_id) }} => hookkit_runtime::run_event::<
            hookkit_antigravity::PreInvocation,
            _,
        >(move |input, environment, context| {
            crate::scaffold::state::ensure_session_state(context, Some(state_dir.as_path()))
                .map_err(std::io::Error::other)?;
            crate::hooks::native::pre_invocation(
                input,
                environment,
                context,
                Some(state_dir.as_path()),
            )
        }),
{%- else %}
{%- for event in event_catalog.events %}
{%- if event.harness == harness and event.stable_id == stable_id %}
        Command::{{ variant(stable_id) }} => hookkit_runtime::run_event::<
            {{ event.rust_event }},
            _,
        >(move |input, environment, context| {
            crate::hooks::native::{{ stable_id }}(
                input,
                environment,
                context,
                {{ handler_state_dir() }},
            )
        }),
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
    }
}
{%- if harness_mode == "cross" and "pre_tool" in aligned_hooks %}
#[rustfmt::skip]
fn run_pre_tool(
    harness: hookkit_core::HarnessId,
    state_dir: Option<std::path::PathBuf>,
) -> std::process::ExitCode {
{%- if starter == "policy_guard" %}
    // A guard that cannot decide denies instead of letting the call run:
    // parse, environment, handler, and emission failures become each
    // harness's native block.
    let options = hookkit_runtime::RunOptions::new().fail_closed();
{%- else %}
    // Failures exit 1, which Claude Code and Codex treat as non-blocking.
    // Use `RunOptions::new().fail_closed()` to deny instead once this hook
    // enforces a policy.
    let options = hookkit_runtime::RunOptions::new();
{%- endif %}
    hookkit_runtime::aligned::run_aligned_event_with_options::<
        hookkit_runtime::aligned::PreToolUse,
        _,
    >(harness, options, move |input, _environment, context| {
        pre_tool_output(input, context, state_dir.as_deref())
    })
}

/// Lower the portable pre-tool policy to one native response.
///
/// "No objection" becomes `PreToolUseOutput::pass_through`, which leaves the
/// call to each harness's normal permission flow: empty output on Claude
/// Code and Codex, and `ask` on Antigravity, which requires a decision.
/// `PreToolUseOutput::allow` would instead auto-approve the call on Claude
/// Code and Antigravity.
#[rustfmt::skip]
pub fn pre_tool_output(
    input: hookkit_common::PreToolUseInput,
    context: &hookkit_core::RuntimeContext<'_>,
    state_dir: Option<&std::path::Path>,
) -> hookkit_core::Result<hookkit_common::PreToolUseOutput> {
{%- if starter == "pre_tool_rewrite" %}
    match crate::hooks::pre_tool::transform(input.tool_input(), state_dir) {
        // Claude Code has no rewrite that defers to its normal permission
        // flow, so the rewritten call is shown to the user for confirmation.
        // Codex applies its normal approval policy to the rewritten call.
        Some(updated_input) => hookkit_common::PreToolUseOutput::rewrite(
            context.harness(),
            updated_input,
            hookkit_common::RewriteApproval::Ask(String::from(
                {{ (package_name ~ " rewrote this tool call") | tojson }},
            )),
        ),
        None => hookkit_common::PreToolUseOutput::pass_through(context.harness()),
    }
{%- elif starter == "policy_guard" %}
    let report = hookkit_tool_access::ToolAccessAnalyzer::default().analyze_pre_tool(&input);
    match crate::hooks::pre_tool::evaluate(&report, state_dir) {
        Decision::Allow => hookkit_common::PreToolUseOutput::pass_through(context.harness()),
        Decision::Deny(reason) => hookkit_common::PreToolUseOutput::deny(context.harness(), reason),
    }
{%- else %}
    match crate::hooks::pre_tool::evaluate(input.tool_name(), state_dir) {
        Decision::Allow => hookkit_common::PreToolUseOutput::pass_through(context.harness()),
        Decision::Deny(reason) => hookkit_common::PreToolUseOutput::deny(context.harness(), reason),
    }
{%- endif %}
}
{%- elif harness_mode == "single" and "pre_tool_use" in native_hooks and starter != "custom" %}
{%- if starter == "scoped_context_once" %}
fn scoped_context(
    input: &hookkit_common::PreToolUseInput,
    context: &hookkit_core::RuntimeContext<'_>,
    state_dir: Option<&std::path::Path>,
) -> hookkit_core::Result<Option<String>> {
    let report = hookkit_tool_access::ToolAccessAnalyzer::default().analyze_pre_tool(input);
    let Some(discovered) = crate::hooks::pre_tool::discover(&report) else {
        return Ok(None);
    };
    let state = crate::scaffold::state::ensure_session_state(context, state_dir)
        .map_err(std::io::Error::other)?;
    let claim = crate::scaffold::state::claim_once(&state, &discovered.claim_key)
        .map_err(std::io::Error::other)?;
    Ok((claim == hookkit_session_state::ClaimResult::Claimed).then_some(discovered.content))
}

#[rustfmt::skip]
fn run_pre_tool(state_dir: Option<std::path::PathBuf>) -> std::process::ExitCode {
{%- else %}
#[rustfmt::skip]
fn run_pre_tool() -> std::process::ExitCode {
{%- endif %}
{%- if harness == "claude-code" %}
    hookkit_runtime::run_event::<hookkit_claude::catalog::PreToolUse, _>(
        |input, _environment, _context| {
{%- if starter != "scoped_context_once" %}
            let tool_name = input
                .field("tool_name")
                .and_then(serde_json::Value::as_str);
{%- endif %}
{%- if starter == "scoped_context_once" %}
            let aligned_input = hookkit_common::PreToolUseInput::Claude(input.clone());
            // Context-only output makes no permission decision, so every call,
            // including the once-per-scope call that delivers the context,
            // keeps Claude Code's normal permission flow. An explicit "allow"
            // would skip the user's permission prompt.
            Ok(match scoped_context(&aligned_input, _context, state_dir.as_deref())? {
                Some(additional_context) => {
                    hookkit_claude::catalog::PreToolUseOutput::with_context(additional_context)
                }
                None => hookkit_claude::catalog::PreToolUseOutput::no_op(),
            })
{%- else %}
            // `Decision::Allow` means "no objection": pass through with empty
            // output so Claude Code's normal permission flow still applies. An
            // explicit "allow" decision would skip the user's permission prompt.
            Ok(match crate::hooks::pre_tool::evaluate(tool_name) {
                Decision::Allow => hookkit_claude::catalog::PreToolUseOutput::no_op(),
                Decision::Deny(reason) => hookkit_claude::catalog::PreToolUseOutput::deny(reason),
            })
{%- endif %}
        },
    )
{%- elif harness == "codex" %}
    hookkit_runtime::run_event::<hookkit_codex::protocol::PreToolUse, _>(
        |input, _environment, _context| {
{%- if starter == "scoped_context_once" %}
            let aligned_input = hookkit_common::PreToolUseInput::Codex(input.clone());
            Ok(match scoped_context(&aligned_input, _context, state_dir.as_deref())? {
                Some(additional_context) => {
                    hookkit_codex::protocol::PreToolUseOutput::with_context(additional_context)
                }
                None => hookkit_codex::protocol::PreToolUseOutput::no_op(),
            })
{%- else %}
            Ok(match crate::hooks::pre_tool::evaluate(Some(&input.tool_name)) {
                Decision::Allow => hookkit_codex::protocol::PreToolUseOutput::no_op(),
                Decision::Deny(reason) => {
                    hookkit_codex::protocol::PreToolUseOutput::deny(reason)
                }
            })
{%- endif %}
        },
    )
{%- elif harness == "antigravity" %}
    hookkit_runtime::run_event::<hookkit_antigravity::PreToolUse, _>(
        |input, _environment, _context| {
            // Antigravity requires a decision and has no pass-through, so "no
            // objection" is `ask`: it respects "Always Allow" grants and
            // prompts only where none covers the call. `allow` would
            // auto-approve every call and bypass the user's Ask presets.
            Ok(match crate::hooks::pre_tool::evaluate(Some(&input.tool_call.name)) {
                Decision::Allow => hookkit_antigravity::PreToolUseOutput::ask(),
                Decision::Deny(reason) => {
                    hookkit_antigravity::PreToolUseOutput::deny().with_reason(reason)
                }
            })
        },
    )
{%- endif %}
}
{%- endif %}
