{% from "templates/hook-project/template/_macros/rust.jinja" import aligned_base, variant -%}
{% macro handler_state_dir() -%}
{%- if state_capabilities -%}
state_dir.as_deref()
{%- else -%}
None
{%- endif -%}
{%- endmacro -%}
{% macro handler_state_dir_owned() -%}
{%- if state_capabilities -%}
state_dir
{%- else -%}
None
{%- endif -%}
{%- endmacro -%}
use super::cli::{Cli, Command};
{%- if (harness_mode == "cross" and "pre_tool" in aligned_hooks) or
      (harness_mode == "single" and "pre_tool_use" in native_hooks) -%}
{%- if starter not in ["pre_tool_rewrite", "scoped_context_once"] and
      (harness_mode == "cross" or starter != "custom") %}
use crate::hooks::pre_tool::Decision;
{%- endif %}
{%- endif %}

/// Execute one explicit hook command.
#[rustfmt::skip]
pub fn run(cli: Cli) -> std::process::ExitCode {
{%- if harness_mode == "cross" %}
    let harness = cli.harness.id();
{%- endif %}
{%- if state_capabilities %}
    let state_dir = cli.state_dir;
{%- endif %}
    match cli.command {
{%- if harness_mode == "cross" %}
{%- for stable_id in aligned_hooks %}
{%- if stable_id == "pre_tool" %}
        Command::{{ variant(stable_id) }} => {
            run_pre_tool(harness, {{ handler_state_dir_owned() }})
        },
{%- elif starter == "session_bootstrap" and stable_id == "session_start" %}
        Command::{{ variant(stable_id) }} => hookkit_runtime::aligned::run_aligned_event::<
            hookkit_runtime::aligned::SessionStart,
            _,
        >(harness, move |input, environment, context| {
            crate::scaffold::state::ensure_session_state(context, state_dir.as_deref())
                .map_err(std::io::Error::other)?;
            let _ = environment;
            match crate::hooks::session_bootstrap::build_context(input.source()) {
                Some(additional_context) => hookkit_common::SessionStartOutput::with_context(
                    context.harness(),
                    additional_context,
                ),
                None => hookkit_common::SessionStartOutput::no_op(context.harness()),
            }
        }),
{%- else %}
        Command::{{ variant(stable_id) }} => hookkit_runtime::aligned::run_aligned_event::<
            hookkit_runtime::aligned::{{ aligned_base(stable_id) }},
            _,
        >(harness, move |input, environment, context| {
            crate::hooks::aligned::{{ stable_id }}(
                input,
                environment,
                context,
                {{ handler_state_dir() }},
            )
        }),
{%- endif %}
{%- endfor %}
{%- else %}
{%- for stable_id in native_hooks %}
{%- if stable_id == "pre_tool_use" and starter == "custom" %}
{%- for event in event_catalog.events %}
{%- if event.harness == harness and event.stable_id == stable_id %}
        Command::{{ variant(stable_id) }} => hookkit_runtime::run_event::<
            {{ event.rust_event }},
            _,
        >(move |input, environment, context| {
            crate::hooks::native::{{ stable_id }}(
                input,
                environment,
                context,
                {{ handler_state_dir() }},
            )
        }),
{%- endif %}
{%- endfor %}
{%- elif stable_id == "pre_tool_use" %}
{%- if starter == "scoped_context_once" %}
        Command::{{ variant(stable_id) }} => run_pre_tool(state_dir),
{%- else %}
        Command::{{ variant(stable_id) }} => run_pre_tool(),
{%- endif %}
{%- else %}
{%- for event in event_catalog.events %}
{%- if event.harness == harness and event.stable_id == stable_id %}
        Command::{{ variant(stable_id) }} => hookkit_runtime::run_event::<
            {{ event.rust_event }},
            _,
        >(move |input, environment, context| {
            crate::hooks::native::{{ stable_id }}(
                input,
                environment,
                context,
                {{ handler_state_dir() }},
            )
        }),
{%- endif %}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- endif %}
    }
}
{%- if harness_mode == "cross" and "pre_tool" in aligned_hooks %}
#[rustfmt::skip]
fn run_pre_tool(
    harness: hookkit_core::HarnessId,
    state_dir: Option<std::path::PathBuf>,
) -> std::process::ExitCode {
    hookkit_runtime::aligned::run_aligned_event::<hookkit_runtime::aligned::PreToolUse, _>(
        harness,
{%- if starter == "pre_tool_rewrite" %}
        |input, _environment, context| {
            match crate::hooks::pre_tool::transform(input.tool_input(), state_dir.as_deref()) {
                Some(updated_input) => {
                    hookkit_common::PreToolUseOutput::rewrite(context.harness(), updated_input)
                }
                None => hookkit_common::PreToolUseOutput::allow(context.harness()),
            }
        },
{%- else %}
{%- if starter == "policy_guard" %}
        |input, _environment, context| {
            let report = hookkit_tool_access::ToolAccessAnalyzer::default()
                .analyze_pre_tool(&input);
            match crate::hooks::pre_tool::evaluate(&report, state_dir.as_deref()) {
                Decision::Allow => hookkit_common::PreToolUseOutput::allow(context.harness()),
                Decision::Deny(reason) => {
                    hookkit_common::PreToolUseOutput::deny(context.harness(), reason)
                }
            }
        },
{%- else %}
        |input, _environment, context| match crate::hooks::pre_tool::evaluate(
            input.tool_name(),
            state_dir.as_deref(),
        ) {
            Decision::Allow => hookkit_common::PreToolUseOutput::allow(context.harness()),
            Decision::Deny(reason) => {
                hookkit_common::PreToolUseOutput::deny(context.harness(), reason)
            }
        },
{%- endif %}
{%- endif %}
    )
}
{%- elif harness_mode == "single" and "pre_tool_use" in native_hooks and starter != "custom" %}
{%- if starter == "scoped_context_once" %}
fn scoped_context(
    input: &hookkit_common::PreToolUseInput,
    context: &hookkit_core::RuntimeContext<'_>,
    state_dir: Option<&std::path::Path>,
) -> hookkit_core::Result<Option<String>> {
    let report = hookkit_tool_access::ToolAccessAnalyzer::default().analyze_pre_tool(input);
    let Some(discovered) = crate::hooks::pre_tool::discover(&report) else {
        return Ok(None);
    };
    let state = crate::scaffold::state::ensure_session_state(context, state_dir)
        .map_err(std::io::Error::other)?;
    let claim = crate::scaffold::state::claim_once(&state, &discovered.claim_key)
        .map_err(std::io::Error::other)?;
    Ok((claim == hookkit_session_state::ClaimResult::Claimed).then_some(discovered.content))
}

#[rustfmt::skip]
fn run_pre_tool(state_dir: Option<std::path::PathBuf>) -> std::process::ExitCode {
{%- else %}
#[rustfmt::skip]
fn run_pre_tool() -> std::process::ExitCode {
{%- endif %}
{%- if harness == "claude-code" %}
    hookkit_runtime::run_event::<hookkit_claude::catalog::PreToolUse, _>(
        |input, _environment, _context| {
{%- if starter != "scoped_context_once" %}
            let tool_name = input
                .field("tool_name")
                .and_then(serde_json::Value::as_str);
{%- endif %}
{%- if starter == "scoped_context_once" %}
            let aligned_input = hookkit_common::PreToolUseInput::Claude(input.clone());
            let additional_context =
                scoped_context(&aligned_input, _context, state_dir.as_deref())?;
            Ok(hookkit_claude::catalog::PreToolUseOutput::decide(
                hookkit_claude::catalog::PreToolPermissionDecision::Allow,
                None,
                None,
                additional_context,
            ))
{%- else %}
            Ok(match crate::hooks::pre_tool::evaluate(tool_name) {
                Decision::Allow => hookkit_claude::catalog::PreToolUseOutput::decide(
                    hookkit_claude::catalog::PreToolPermissionDecision::Allow,
                    None,
                    None,
                    None,
                ),
                Decision::Deny(reason) => hookkit_claude::catalog::PreToolUseOutput::decide(
                    hookkit_claude::catalog::PreToolPermissionDecision::Deny,
                    Some(reason),
                    None,
                    None,
                ),
            })
{%- endif %}
        },
    )
{%- elif harness == "codex" %}
    hookkit_runtime::run_event::<hookkit_codex::protocol::PreToolUse, _>(
        |input, _environment, _context| {
{%- if starter == "scoped_context_once" %}
            let aligned_input = hookkit_common::PreToolUseInput::Codex(input.clone());
            Ok(match scoped_context(&aligned_input, _context, state_dir.as_deref())? {
                Some(additional_context) => {
                    hookkit_codex::protocol::PreToolUseOutput::with_context(additional_context)
                }
                None => hookkit_codex::protocol::PreToolUseOutput::no_op(),
            })
{%- else %}
            Ok(match crate::hooks::pre_tool::evaluate(Some(&input.tool_name)) {
                Decision::Allow => hookkit_codex::protocol::PreToolUseOutput::no_op(),
                Decision::Deny(reason) => {
                    hookkit_codex::protocol::PreToolUseOutput::deny(reason)
                }
            })
{%- endif %}
        },
    )
{%- elif harness == "antigravity" %}
    hookkit_runtime::run_event::<hookkit_antigravity::PreToolUse, _>(
        |input, _environment, _context| {
            let (decision, reason) = match crate::hooks::pre_tool::evaluate(Some(
                &input.tool_call.name,
            )) {
                Decision::Allow => (hookkit_antigravity::ToolDecision::Allow, None),
                Decision::Deny(reason) => {
                    (hookkit_antigravity::ToolDecision::Deny, Some(reason))
                }
            };
            Ok(hookkit_antigravity::PreToolUseOutput {
                decision,
                reason,
                permission_overrides: Vec::new(),
            })
        },
    )
{%- endif %}
}
{%- endif %}
