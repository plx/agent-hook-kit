//! Copier-owned session-state construction and typed capability adapters.
//!
//! Keep the family and entity versions stable while their persisted schemas
//! remain compatible. Bump the corresponding version before making an
//! incompatible change.

use hookkit_core::{HarnessId, RuntimeContext};
use hookkit_session_state::{FamilyId, Result, SessionState, StateFamily, StateRoot};
use std::path::{Path, PathBuf};

/// On-disk namespace for this generated hook family.
pub const STATE_FAMILY: &str = {{ package_name | tojson }};

/// Persisted schema version for this generated hook family.
///
/// Bump this before making an incompatible change to any family-wide state.
pub const STATE_FAMILY_VERSION: u32 = 1;

/// Stable package-specific directory beneath HookKit's generated-state root.
pub const PACKAGE_STATE_DIRECTORY: &str = {{ package_name | tojson }};

/// Resolve the common state root used by every generated subcommand.
///
/// A `--state-dir` value is passed as `override_dir`. Without one, state is
/// isolated in [`default_state_root`]. A relative override is anchored at
/// the harness's stable project root, exactly as HookKit's runners anchor
/// it, so template-owned and runner-owned commands share one directory; see
/// [`anchor_state_dir`].
pub fn resolve_state_root(
    context: &RuntimeContext<'_>,
    override_dir: Option<&Path>,
) -> Result<StateRoot> {
    match override_dir {
        Some(path) => Ok(StateRoot::new(anchor_state_dir(context, path))),
        None => default_state_root(),
    }
}

/// Ensure typed state and capture the exact metadata available to this event.
pub fn ensure_session_state(
    context: &RuntimeContext<'_>,
    override_dir: Option<&Path>,
) -> Result<SessionState> {
    SessionState::ensure(context, resolve_state_root(context, override_dir)?)
}

/// Open this generated tool's independently versioned state family.
pub fn state_family(state: &SessionState) -> Result<StateFamily> {
    state.family(FamilyId::new(STATE_FAMILY, STATE_FAMILY_VERSION)?)
}

/// Default per-user state root for this package.
///
/// It is `generated/{{ package_name }}/` inside HookKit's per-user directory
/// (`$TMPDIR/agent-hook-kit-<uid>/` on Unix), beside HookKit's own default
/// state root. HookKit creates that directory owner-only and refuses one that
/// another user owns or planted, as it does for `StateRoot::default()`, so
/// users who share a temporary directory cannot lock each other out or
/// tamper with each other's state. Pass `--state-dir` to choose another
/// location; an explicit directory is used as given.
pub fn default_state_root() -> Result<StateRoot> {
    StateRoot::per_user(Path::new("generated").join(PACKAGE_STATE_DIRECTORY))
}

/// Anchors a relative `--state-dir` at the harness's stable project root.
///
/// Claude Code runs hooks in the agent's current directory, which follows
/// `cd` in its Bash tool, so a relative state directory would otherwise
/// split one session's state across directories. Like HookKit's runners,
/// this resolves a relative path against `CLAUDE_PROJECT_DIR` on Claude Code
/// and against the event's first working directory elsewhere. Absolute
/// paths, and relative paths without an absolute anchor, are unchanged.
pub fn anchor_state_dir(context: &RuntimeContext<'_>, path: &Path) -> PathBuf {
    let project_root = if *context.harness() == HarnessId::CLAUDE_CODE {
        std::env::var_os("CLAUDE_PROJECT_DIR").map(PathBuf::from)
    } else {
        context
            .workspace_roots()
            .first()
            .map(|root| PathBuf::from(root.as_str()))
    };
    anchor_state_dir_at(path, project_root)
}

fn anchor_state_dir_at(path: &Path, project_root: Option<PathBuf>) -> PathBuf {
    match project_root {
        Some(project_root) if path.is_relative() && project_root.is_absolute() => {
            project_root.join(path)
        }
        _ => path.to_path_buf(),
    }
}
{% if 'file_activity' in state_capabilities %}
/// Open the package-isolated pending file-activity and reconciliation journals.
pub fn file_activity_store(
    context: &RuntimeContext<'_>,
    override_dir: Option<&Path>,
) -> hookkit_file_activity::Result<hookkit_file_activity::FileActivityStore> {
    hookkit_file_activity::FileActivityStore::ensure(
        context,
        resolve_state_root(context, override_dir)?,
    )
}
