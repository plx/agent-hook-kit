#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn default_state_root_is_beside_the_per_user_default_root() {
        let root = default_state_root().expect("the package directory is a plain relative path");
        let package = Path::new("generated").join(PACKAGE_STATE_DIRECTORY);
        assert!(root.path().ends_with(package));
        assert_eq!(
            root.path().parent().and_then(Path::parent),
            StateRoot::default().path().parent(),
        );
    }

    #[test]
    fn relative_state_dirs_resolve_against_the_project_root() {
        let project = std::env::temp_dir().join("project");
        assert_eq!(
            anchor_state_dir_at(Path::new(".hookkit-state"), Some(project.clone())),
            project.join(".hookkit-state"),
        );
        let absolute = std::env::temp_dir().join("elsewhere/state");
        assert_eq!(anchor_state_dir_at(&absolute, Some(project)), absolute);
        assert_eq!(
            anchor_state_dir_at(Path::new(".hookkit-state"), None),
            PathBuf::from(".hookkit-state"),
        );
        assert_eq!(
            anchor_state_dir_at(Path::new(".hookkit-state"), Some(PathBuf::from("relative"))),
            PathBuf::from(".hookkit-state"),
        );
    }
}
