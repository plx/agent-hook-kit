{% if 'claim_once' in state_capabilities %}
/// Stable name of the first-writer-wins claim set.
pub const CLAIM_ONCE_SET: &str = "once";

/// Atomically claim `key` once for this family and native session.
pub fn claim_once(state: &SessionState, key: &str) -> Result<hookkit_session_state::ClaimResult> {
    state_family(state)?.claims(CLAIM_ONCE_SET)?.try_claim(key)
}
{% endif -%}
{% if 'inspectable_set' in state_capabilities %}
/// Stable identity of the inspectable set entity.
pub const INSPECTABLE_SET_ENTITY: &str = "observed-values";

/// Persisted schema version of the inspectable set entity.
///
/// Bump this before changing the meaning or representation of stored values.
pub const INSPECTABLE_SET_ENTITY_VERSION: u32 = 1;

/// Open the session-wide, monotonic set of inspectable values.
pub fn inspectable_set(state: &SessionState) -> Result<hookkit_session_state::SetJournal<String>> {
    state_family(state)?.session_scope()?.set(
        hookkit_session_state::EntityId::new(
            INSPECTABLE_SET_ENTITY,
            INSPECTABLE_SET_ENTITY_VERSION,
        )?,
        hookkit_session_state::EntityMode::Monotonic,
    )
}
{% endif -%}
{% if 'record_queue' in state_capabilities %}
/// Schema version owned beside the protected queue record type.
pub use crate::hooks::state_types::RECORD_QUEUE_VERSION;

/// Stable identity prefix of the acknowledgeable record queue.
pub const RECORD_QUEUE: &str = "records";

/// Open the session-wide sparse record queue.
///
/// Call `append` to enqueue a typed JSON value, `snapshot` to inspect a
/// point-in-time batch, and `acknowledge` on that batch after successful work.
pub fn record_queue(state: &SessionState) -> Result<hookkit_session_state::RecordJournal> {
    let name = format!("{RECORD_QUEUE}-v{RECORD_QUEUE_VERSION}");
    state_family(state)?.record_journal(&name)
}

/// Append one typed, content-addressed record to the queue.
pub fn enqueue_record(
    state: &SessionState,
    event_key: &str,
    record: &crate::hooks::state_types::QueueRecord,
) -> Result<hookkit_session_state::JournalEntryId> {
    record_queue(state)?.append(event_key, record)
}

/// Capture the current typed queue batch for inspection and acknowledgement.
pub fn snapshot_records(
    state: &SessionState,
) -> Result<hookkit_session_state::RecordJournalBatch<crate::hooks::state_types::QueueRecord>> {
    record_queue(state)?.snapshot()
}
{% endif -%}
{% if 'run_artifacts' in state_capabilities %}
/// Stable identity prefix of committed run bundles.
pub const RUN_ARTIFACTS: &str = "artifacts";

/// Persisted schema version of run summaries and their referenced artifacts.
///
/// Bump this before changing the committed `summary.json` schema.
pub const RUN_ARTIFACTS_VERSION: u32 = 1;

/// Start one run bundle for relative artifacts and a committed summary.
pub fn start_artifact_run(
    state: &SessionState,
    label: &str,
) -> Result<hookkit_session_state::RunBundle> {
    let label = format!("{RUN_ARTIFACTS}-v{RUN_ARTIFACTS_VERSION}-{label}");
    state_family(state)?.start_run(&label)
}
{% endif -%}
{% if 'custom_aggregate' in state_capabilities %}
/// Schema version and persistence mode owned beside the protected aggregate.
pub use crate::hooks::state_types::{CUSTOM_AGGREGATE_ENTITY_VERSION, CUSTOM_AGGREGATE_MODE};

/// Stable identity of the custom typed aggregate entity.
pub const CUSTOM_AGGREGATE_ENTITY: &str = "custom-aggregate";

/// Open the advanced typed event/aggregate journal.
pub fn custom_aggregate(
    state: &SessionState,
) -> Result<hookkit_session_state::EntityJournal<crate::hooks::state_types::CustomAggregate>> {
    state_family(state)?.session_scope()?.entity(
        hookkit_session_state::EntityId::new(
            CUSTOM_AGGREGATE_ENTITY,
            CUSTOM_AGGREGATE_ENTITY_VERSION,
        )?,
        CUSTOM_AGGREGATE_MODE,
    )
}
