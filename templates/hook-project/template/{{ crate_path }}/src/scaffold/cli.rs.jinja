{% from "templates/hook-project/template/_macros/rust.jinja" import variant -%}
{% set guard_only = starter == "policy_guard" and aligned_hooks | length == 1 and "pre_tool" in aligned_hooks -%}
{% if harness_mode == "cross" -%}
use super::harness::Harness;
{% endif -%}
use clap::{Parser, Subcommand};
{% if starter in ["immediate_quality", "deferred_quality"] or state_capabilities -%}
use std::path::PathBuf;
{% endif -%}

/// {{ project_name }} command-line interface.
#[derive(Debug, Parser)]
#[rustfmt::skip]
#[command(
    name = {{ binary_name | tojson }},
    about = {{ description | tojson }}
)]
pub struct Cli {
{%- if harness_mode == "cross" %}
    /// Harness whose native contract should parse and emit this invocation.
    #[arg(long, value_enum)]
    pub harness: Harness,
{%- endif %}
{% if starter in ["immediate_quality", "deferred_quality"] or "file_activity" in state_capabilities %}
    /// Package-owned Pkl policy passed explicitly to the HookKit runner.
    #[arg(long, value_name = "PATH")]
    pub config: Option<PathBuf>,
{% endif %}
{% if starter == "deferred_quality" or state_capabilities %}
    /// Shared package-specific HookKit state root override.
    #[arg(long, value_name = "PATH")]
    pub state_dir: Option<PathBuf>,
{% endif %}
    /// Explicit hook event to execute.
    #[command(subcommand)]
    pub command: Command,
}

impl Cli {
    /// Parse arguments and reject cross-field combinations Clap cannot express
    /// through derive attributes alone.
    ///
{%- if guard_only %}
    /// On failure this prints the requested help or version text, or answers
    /// a usage error with [`argument_error_response`], and returns the
    /// process status to exit with.
    pub fn parse_validated() -> Result<Self, std::process::ExitCode> {
        Self::try_parse().and_then(Self::validate).map_err(|error| {
            if error.use_stderr() {
                return argument_error_response(&error, std::env::args_os()).emit();
            }
            // Printing can only fail when the standard streams are gone,
            // and the returned status still reports the outcome.
            let _ = error.print();
            std::process::ExitCode::SUCCESS
        })
    }
{%- else %}
    /// On failure this prints Clap's diagnostic, or the requested help or
    /// version text, and returns the process status to exit with. See
    /// [`argument_error_status`] for why usage errors never exit with 2.
    pub fn parse_validated() -> Result<Self, std::process::ExitCode> {
        Self::try_parse().and_then(Self::validate).map_err(|error| {
            // Printing can only fail when the standard streams are gone,
            // and the returned status still reports the outcome.
            let _ = error.print();
            std::process::ExitCode::from(argument_error_status(&error))
        })
    }
{%- endif %}
{% if harness_mode == "cross" and "file_activity" in state_capabilities and "antigravity" in harnesses %}
    /// Validate command/harness compatibility for programmatic callers.
    pub fn validate(self) -> Result<Self, clap::Error> {
        if matches!(self.harness, Harness::Antigravity)
            && matches!(&self.command, Command::SessionStartState)
        {
            return Err(clap::Error::raw(
                clap::error::ErrorKind::InvalidValue,
                "session-start-state supports Claude Code and Codex only; Antigravity uses inferred first-observation bootstrap",
            ));
        }
        Ok(self)
    }
{% else %}
    /// Validate command/harness compatibility for programmatic callers.
    pub fn validate(self) -> Result<Self, clap::Error> {
        Ok(self)
    }
{% endif -%}
}

{% if guard_only -%}
/// Native response to a usage error, such as a misregistered command.
///
/// This policy guard's only command is its pre-tool gate, and a guard that
/// cannot decide denies. A usage error is therefore answered like any other
/// failure under `RunOptions::fail_closed`: exit 2 with the usage message on
/// stderr, which blocks the tool call on Claude Code and Codex, or a JSON
/// `deny` decision when `--harness antigravity` was given, because
/// Antigravity documents no exit-status semantics. When the harness itself
/// cannot be read from `arguments`, the response is exit 2. Adding another
/// aligned family to this package switches to non-blocking status 1, because
/// exit 2 would also erase prompts or keep a session from stopping.
pub fn argument_error_response(
    error: &clap::Error,
    arguments: impl IntoIterator<Item = std::ffi::OsString>,
) -> hookkit_runtime::failure::FailureResponse {
    let diagnostic = format!(
        "{}: {}",
        {{ binary_name | tojson }},
        error.render().to_string().trim_end(),
    );
    // Without a readable harness, answer as Claude Code and Codex expect.
    let harness =
        requested_harness(arguments).map_or(hookkit_core::HarnessId::CLAUDE_CODE, Harness::id);
    hookkit_runtime::failure::failure_response(
        hookkit_runtime::FailurePolicy::FailClosed,
        &harness,
        None,
        &diagnostic,
    )
}

/// The `--harness` value in raw arguments that failed to parse, if valid.
fn requested_harness(arguments: impl IntoIterator<Item = std::ffi::OsString>) -> Option<Harness> {
    let mut arguments = arguments.into_iter();
    while let Some(argument) = arguments.next() {
        let Some(argument) = argument.to_str().map(str::to_owned) else {
            continue;
        };
        let value = match argument.strip_prefix("--harness") {
            Some("") => arguments.next()?.into_string().ok()?,
            Some(inline) => match inline.strip_prefix('=') {
                Some(value) => value.to_owned(),
                None => continue,
            },
            None => continue,
        };
        return <Harness as clap::ValueEnum>::from_str(&value, false).ok();
    }
    None
}
{%- else -%}
/// Process status for a Clap parse or validation outcome.
///
/// Help and version requests succeed with 0. Every argument error uses the
/// non-blocking failure status 1 instead of Clap's default 2, because Claude
/// Code and Codex treat exit status 2 from a hook as a blocking decision: a
/// misregistered command would otherwise block tool calls, erase prompts, or
/// keep a session from stopping.
{%- if starter == "policy_guard" %}
///
/// This policy guard also serves other aligned families, so a usage error
/// fails open: the misregistered pre-tool gate lets tool calls run. Keep the
/// guard in a package whose only family is `pre_tool` to deny instead.
{%- endif %}
pub fn argument_error_status(error: &clap::Error) -> u8 {
    if error.use_stderr() { 1 } else { 0 }
}
{%- endif %}

/// Selected hook commands. Names remain stable when more hooks are added.
#[derive(Debug, Subcommand)]
pub enum Command {
{%- if harness_mode == "cross" %}
{%- for stable_id in aligned_hooks %}
    /// Execute the {{ stable_id | replace('_', ' ') }} aligned family.
    #[command(name = {{ stable_id | replace('_', '-') | tojson }})]
    {{ variant(stable_id) }},
{%- endfor %}
{%- if starter == "deferred_quality" or "file_activity" in state_capabilities %}
    /// Record an exact Claude Code or Codex session-start lower bound.
    #[command(name = "session-start-state")]
    SessionStartState,
{%- endif %}
{%- else %}
{%- for stable_id in native_hooks %}
{%- set selected_event = namespace(value=none) %}
{%- for event in event_catalog.events %}
{%- if event.harness == harness and event.stable_id == stable_id %}
{%- set selected_event.value = event %}
{%- endif %}
{%- endfor %}
{%- if selected_event.value.starter.strategy == "must_implement" %}
    /// Scaffold-only exact {{ stable_id | replace('_', ' ') }} event.
    ///
    /// Its safe starter fails explicitly; implement the protected handler
    /// before registering this command with the harness.
{%- else %}
    /// Execute the exact {{ stable_id | replace('_', ' ') }} native event.
{%- endif %}
    #[command(name = {{ stable_id | replace('_', '-') | tojson }})]
    {{ variant(stable_id) }},
{%- endfor %}
{%- endif %}
}
