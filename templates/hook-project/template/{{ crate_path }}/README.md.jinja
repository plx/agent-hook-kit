{% endif -%}
{% else -%}
{% for stable_id in native_hooks -%}
{{ binary_name }} \
{% if "file_activity" in state_capabilities and stable_id == "stop" %}  --config <absolute-config-path> \
{% endif %}{% if state_capabilities %}  --state-dir <state-directory> \
{% endif %}  {{ stable_id | replace('_', '-') }}
{% endfor -%}
{% endif -%}
