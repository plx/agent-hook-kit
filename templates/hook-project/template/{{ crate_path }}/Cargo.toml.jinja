{% from "templates/hook-project/template/_macros/dependencies.jinja" import hookkit_spec with context -%}
[package]
name = {{ package_name | tojson }}
version = "0.1.0"
edition = "2024"
description = {{ description | tojson }}
license = {{ license | tojson }}
rust-version = {{ compatibility.rust_msrv | string | tojson }}
publish = false

[[bin]]
name = {{ binary_name | tojson }}
path = "src/main.rs"

[dependencies]
clap = { version = "4.6", features = ["derive"] }
hookkit-core = {{ hookkit_spec("hookkit-core") }}
hookkit-runtime = {{ hookkit_spec("hookkit-runtime") }}
{%- if starter == "pre_tool_rewrite" %}
serde_json = "1"
{%- endif %}
{%- if state_capabilities %}
hookkit-session-state = {{ hookkit_spec("hookkit-session-state") }}
{%- endif %}
{%- if "record_queue" in state_capabilities or "custom_aggregate" in state_capabilities %}
serde = { version = "1", features = ["derive"] }
{%- endif %}
{%- if starter in ["policy_guard", "scoped_context_once"] %}
hookkit-tool-access = {{ hookkit_spec("hookkit-tool-access") }}
{%- endif %}
{%- if harness_mode == "cross" %}
hookkit-common = {{ hookkit_spec("hookkit-common") }}
{%- elif harness == "claude-code" %}
hookkit-claude = {{ hookkit_spec("hookkit-claude") }}
{%- elif harness == "codex" %}
hookkit-codex = {{ hookkit_spec("hookkit-codex") }}
{%- elif harness == "antigravity" %}
hookkit-antigravity = {{ hookkit_spec("hookkit-antigravity") }}
{%- endif %}
{%- if harness_mode == "single" and starter == "scoped_context_once" %}
hookkit-common = {{ hookkit_spec("hookkit-common") }}
{%- endif %}

[lints.rust]
unsafe_code = "forbid"
