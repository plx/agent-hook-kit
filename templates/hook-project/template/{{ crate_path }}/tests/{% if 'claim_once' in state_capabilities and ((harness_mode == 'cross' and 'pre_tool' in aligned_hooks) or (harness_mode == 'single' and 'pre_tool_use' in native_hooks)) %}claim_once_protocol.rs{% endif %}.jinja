//! The generated first-writer-wins seam acts once per native session.

fn temporary_state_root() -> std::path::PathBuf {
    std::env::temp_dir().join(format!(
        "{{ package_name }}-claim-test-{}-{}",
        std::process::id(),
        std::time::SystemTime::now()
            .duration_since(std::time::UNIX_EPOCH)
            .expect("system clock should follow the Unix epoch")
            .as_nanos(),
    ))
}

#[test]
#[rustfmt::skip]
fn claim_once_returns_claimed_then_already_claimed() {
    let state_root = temporary_state_root();
{% if harness_mode == "cross" -%}
{% set claim_harness = 'claude-code' if 'claude-code' in harnesses else ('codex' if 'codex' in harnesses else 'antigravity') -%}
{% set claim_event = event_catalog.events | selectattr('harness', 'equalto', claim_harness) | selectattr('stable_id', 'equalto', 'pre_tool_use') | first -%}
{% if claim_harness == "claude-code" -%}
    let variables = hookkit_core::EnvironmentVariables::from_pairs([
        ("CLAUDECODE", "1"),
        ("CLAUDE_CODE_CHILD_SESSION", "1"),
        ("CLAUDE_CODE_SESSION_ID", {{ claim_event.fixture.value.session_id | string | tojson }}),
        ("CLAUDE_PROJECT_DIR", {{ claim_event.fixture.value.cwd | string | tojson }}),
    ]);
{%- else -%}
    let variables = hookkit_core::EnvironmentVariables::new();
{%- endif %}
    let emission = hookkit_runtime::aligned::execute_aligned_event::<
        hookkit_runtime::aligned::PreToolUse,
        _,
    >(
        {% if claim_harness == "claude-code" -%}
        hookkit_core::HarnessId::CLAUDE_CODE,
        {%- elif claim_harness == "codex" -%}
        hookkit_core::HarnessId::CODEX,
        {%- else -%}
        hookkit_core::HarnessId::ANTIGRAVITY,
        {%- endif %}
        include_bytes!(concat!("../fixtures/", {{ claim_harness | tojson }}, "/pre_tool_use.json")),
        &variables,
        |_input, _environment, context| {
            let state = {{ package_name | replace('-', '_') }}::scaffold::state::ensure_session_state(
                context,
                Some(&state_root),
            )
            .expect("session state should initialize");
            assert_eq!(
                {{ package_name | replace('-', '_') }}::scaffold::state::claim_once(&state, "same-scope")
                    .expect("first claim should succeed"),
                hookkit_session_state::ClaimResult::Claimed,
            );
            assert_eq!(
                {{ package_name | replace('-', '_') }}::scaffold::state::claim_once(&state, "same-scope")
                    .expect("second claim should be readable"),
                hookkit_session_state::ClaimResult::AlreadyClaimed,
            );
            hookkit_common::PreToolUseOutput::allow(context.harness())
        },
    )
    .expect("aligned pre-tool fixture should create session state");
{%- else %}
{% set claim_event = event_catalog.events | selectattr('harness', 'equalto', harness) | selectattr('stable_id', 'equalto', 'pre_tool_use') | first -%}
{% if harness == "claude-code" -%}
    let variables = hookkit_core::EnvironmentVariables::from_pairs([
        ("CLAUDECODE", "1"),
        ("CLAUDE_CODE_CHILD_SESSION", "1"),
        ("CLAUDE_CODE_SESSION_ID", {{ claim_event.fixture.value.session_id | string | tojson }}),
        ("CLAUDE_PROJECT_DIR", {{ claim_event.fixture.value.cwd | string | tojson }}),
    ]);
{%- else -%}
    let variables = hookkit_core::EnvironmentVariables::new();
{%- endif %}
    let emission = hookkit_runtime::execute_typed::<{{ claim_event.rust_event }}, _>(
        include_bytes!(concat!("../fixtures/", {{ harness | tojson }}, "/pre_tool_use.json")),
        &variables,
        |_input, _environment, context| {
            let state = {{ package_name | replace('-', '_') }}::scaffold::state::ensure_session_state(
                context,
                Some(&state_root),
            )
            .expect("session state should initialize");
            assert_eq!(
                {{ package_name | replace('-', '_') }}::scaffold::state::claim_once(&state, "same-scope")
                    .expect("first claim should succeed"),
                hookkit_session_state::ClaimResult::Claimed,
            );
            assert_eq!(
                {{ package_name | replace('-', '_') }}::scaffold::state::claim_once(&state, "same-scope")
                    .expect("second claim should be readable"),
                hookkit_session_state::ClaimResult::AlreadyClaimed,
            );
            Ok({{ claim_event.starter.expression }})
        },
    )
    .expect("native pre-tool fixture should create session state");
{%- endif %}

    assert_eq!(emission.exit_code(), 0);
    std::fs::remove_dir_all(&state_root).expect("temporary claim state should be removable");
}
