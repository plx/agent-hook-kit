#[test]
fn command_tree_is_internally_consistent() {
    {{ package_name | replace('-', '_') }}::scaffold::cli::Cli::command().debug_assert();
}
{% if harness_mode == "cross" and "file_activity" in state_capabilities and "antigravity" in harnesses %}
#[test]
fn antigravity_cannot_select_exact_session_start_support() {
    let cli = {{ package_name | replace('-', '_') }}::scaffold::cli::Cli::try_parse_from([
        {{ binary_name | tojson }},
        "--harness",
        "antigravity",
        "--config",
        "config/generated.pkl",
        "--state-dir",
        "/tmp/generated-state",
        "session-start-state",
    ])
    .expect("the individual arguments are syntactically valid");

    assert!(cli.validate().is_err());
}
{% endif -%}
