//! End-to-end Antigravity runner lowering with a hermetic fake executable.

#![cfg(unix)]

use std::io::Write as _;
use std::os::unix::fs::PermissionsExt as _;
use std::path::{Path, PathBuf};
use std::process::{Command, Stdio};
use std::time::{SystemTime, UNIX_EPOCH};

struct ScratchDirectory(PathBuf);

impl ScratchDirectory {
    fn new() -> Self {
        let nonce = SystemTime::now()
            .duration_since(UNIX_EPOCH)
            .expect("system clock must follow the Unix epoch")
            .as_nanos();
        let path = std::env::temp_dir().join(format!(
            "{{ package_name }}-antigravity-runner-{}-{nonce}",
            std::process::id(),
        ));
        std::fs::create_dir_all(&path).expect("scratch directory must be creatable");
        Self(path)
    }

    fn path(&self) -> &Path {
        &self.0
    }
}

impl Drop for ScratchDirectory {
    fn drop(&mut self) {
        let _ = std::fs::remove_dir_all(&self.0);
    }
}

#[test]
fn warning_mode_runs_tool_and_records_unavailable_antigravity_messages() {
    let scratch = ScratchDirectory::new();
    let workspace = scratch.path().join("workspace");
    let source_dir = workspace.join("src");
    let artifacts = scratch.path().join("antigravity-artifacts");
    let fake_bin = scratch.path().join("bin");
    let marker = scratch.path().join("fake-tool-arguments.txt");
    std::fs::create_dir_all(&source_dir).unwrap();
    std::fs::create_dir_all(&artifacts).unwrap();
    std::fs::create_dir_all(&fake_bin).unwrap();
    std::fs::write(source_dir.join("generated.rs"), "fn generated() {}\n").unwrap();

    let executable = fake_bin.join("custom-quality-check");
    std::fs::write(
        &executable,
        "#!/bin/sh\nprintf '%s\\n' \"$@\" > \"$HOOKKIT_FAKE_MARKER\"\nprintf 'hermetic custom issue\\n' >&2\nexit 1\n",
    )
    .unwrap();
    let mut permissions = std::fs::metadata(&executable).unwrap().permissions();
    permissions.set_mode(0o755);
    std::fs::set_permissions(&executable, permissions).unwrap();

    let input = serde_json::to_vec(&serde_json::json!({
        "conversationId": "generated-runner-conversation",
        "workspacePaths": [workspace],
        "transcriptPath": scratch.path().join("transcript.jsonl"),
        "artifactDirectoryPath": artifacts,
        "toolCall": {
            "name": "run_command",
            "args": {
                "CommandLine": "printf updated > src/generated.rs",
                "Cwd": workspace,
            },
        },
        "stepIdx": 7,
    }))
    .unwrap();
    let config = Path::new(env!("CARGO_MANIFEST_DIR")).join({{ quality_config_path | replace(crate_path ~ '/', '', 1) | tojson }});
    let path = std::env::var_os("PATH").unwrap_or_default();
    let mut executable_paths = vec![fake_bin.clone()];
    executable_paths.extend(std::env::split_paths(&path));
    let joined_path = std::env::join_paths(executable_paths).unwrap();

    let mut child = Command::new(env!("CARGO_BIN_EXE_{{ binary_name }}"))
        .args([
            "--harness",
            "antigravity",
            "--config",
            config.to_str().unwrap(),
            "post-tool",
        ])
        .current_dir(&workspace)
        .env("PATH", joined_path)
        .env("HOOKKIT_FAKE_MARKER", &marker)
        .stdin(Stdio::piped())
        .stdout(Stdio::piped())
        .stderr(Stdio::piped())
        .spawn()
        .expect("generated runner binary must start");
    child
        .stdin
        .take()
        .unwrap()
        .write_all(&input)
        .expect("fixture must reach hook stdin");
    let output = child.wait_with_output().unwrap();

    assert!(
        output.status.success(),
        "stderr: {}",
        String::from_utf8_lossy(&output.stderr)
    );
    assert_eq!(output.stdout, b"{}");
    assert!(
        marker.is_file(),
        "the hermetic quality executable was not invoked"
    );

    let stderr = String::from_utf8(output.stderr).unwrap();
    let record_path = stderr
        .split("full lowering record: ")
        .nth(1)
        .expect("warning stderr must identify the durable loss record")
        .trim();
    let record_path = Path::new(record_path);
    assert!(record_path.starts_with(&artifacts));
    let record: serde_json::Value =
        serde_json::from_slice(&std::fs::read(record_path).unwrap()).unwrap();
    assert_eq!(record["kind"], "post-tool-use-lowering-loss");
    assert_eq!(record["harness"], "antigravity");
    assert!(
        !record["unavailable"]["userNotices"]
            .as_array()
            .unwrap()
            .is_empty()
    );
    assert!(
        !record["unavailable"]["agentFeedback"]
            .as_array()
            .unwrap()
            .is_empty()
    );
}
