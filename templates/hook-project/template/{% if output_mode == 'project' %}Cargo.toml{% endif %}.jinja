[workspace]
# The MSRV-aware resolver selects dependency versions whose `rust-version`
# fits the workspace MSRV, so a fresh lockfile still builds on Rust {{ compatibility.rust_msrv }}.
resolver = "3"
members = [{{ crate_path | tojson }}]

[workspace.package]
edition = "2024"
license = {{ license | tojson }}
rust-version = {{ compatibility.rust_msrv | string | tojson }}
